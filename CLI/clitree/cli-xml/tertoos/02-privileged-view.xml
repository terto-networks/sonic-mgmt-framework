      <ACTION>vtysh -c "clear ipv6 ospf6 process"</ACTION>
    </COMMAND>

    <!-- ===== S5 — IS-IS show/clear ========================================= -->
    <COMMAND name="show isis summary" help="IS-IS summary">
      <ACTION>vtysh -c "show isis summary"</ACTION>
    </COMMAND>
    <COMMAND name="show isis topology" help="IS-IS topology">
      <ACTION>vtysh -c "show isis topology"</ACTION>
    </COMMAND>
    <COMMAND name="show isis database" help="IS-IS LSP database">
      <PARAM name="detail" help="detail (optional)" ptype="STRING" optional="true"/>
      <ACTION>vtysh -c "show isis database ${detail}"</ACTION>
    </COMMAND>
    <COMMAND name="show isis neighbor" help="IS-IS neighbors">
      <ACTION>vtysh -c "show isis neighbor"</ACTION>
    </COMMAND>
    <COMMAND name="show isis interface" help="IS-IS per-interface state">
      <PARAM name="ifname" help="Interface (optional)" ptype="STRING" optional="true"/>
      <ACTION>vtysh -c "show isis interface ${ifname}"</ACTION>
    </COMMAND>
    <COMMAND name="show isis route" help="IS-IS computed routes">
      <ACTION>vtysh -c "show isis route"</ACTION>
    </COMMAND>
    <COMMAND name="show isis segment-routing prefix-sids" help="SR prefix-SID map">
      <ACTION>vtysh -c "show isis segment-routing prefix-sids"</ACTION>
    </COMMAND>
    <COMMAND name="clear isis" help="Reset IS-IS adjacencies">
      <PARAM name="vrf_kw" help="vrf (optional)" ptype="STRING" optional="true"/>
      <PARAM name="vrf" help="VRF name" ptype="STRING" optional="true"/>
      <ACTION>
        if [ -n "${vrf}" ]; then&#xA;
            vtysh -c "clear isis vrf ${vrf}"&#xA;
        else&#xA;
            vtysh -c "clear isis *"&#xA;
        fi&#xA;
      </ACTION>
    </COMMAND>

    <COMMAND name="show qos map dscp-to-tc" help="DSCP→TC maps">
      <ACTION>show qos map dscp-tc 2&gt;/dev/null || sonic-db-cli CONFIG_DB keys 'DSCP_TO_TC_MAP|*'</ACTION>
    </COMMAND>
    <COMMAND name="show qos map tc-to-queue" help="TC→Queue maps">
      <ACTION>show qos map tc-queue 2&gt;/dev/null || sonic-db-cli CONFIG_DB keys 'TC_TO_QUEUE_MAP|*'</ACTION>
    </COMMAND>
    <COMMAND name="show qos map tc-to-pg" help="TC→PG maps">
      <ACTION>show qos map tc-pg 2&gt;/dev/null || sonic-db-cli CONFIG_DB keys 'TC_TO_PRIORITY_GROUP_MAP|*'</ACTION>
    </COMMAND>
    <COMMAND name="show qos scheduler" help="Scheduler profiles">
      <ACTION>show qos scheduler 2&gt;/dev/null || sonic-db-cli CONFIG_DB keys 'SCHEDULER|*'</ACTION>
    </COMMAND>
    <COMMAND name="show qos interface" help="Per-port QoS bindings">
      <PARAM name="port" help="Port (e.g. Ethernet0)" ptype="STRING"/>
      <ACTION>show qos port ${port} 2&gt;/dev/null || sonic-db-cli CONFIG_DB hgetall "PORT_QOS_MAP|${port}"</ACTION>
    </COMMAND>
    <COMMAND name="show queue counters" help="Per-port per-queue counters">
      <PARAM name="port" help="Port (optional)" ptype="STRING_WITH_PIPE" optional="true"/>
      <ACTION>show queue counters ${port}</ACTION>
    </COMMAND>
    <COMMAND name="show class-map" help="Class-maps">
      <PARAM name="name" help="Class-map name (optional)" ptype="STRING" optional="true"/>
      <ACTION>
        if [ -n "${name}" ]; then&#xA;
            sonic-db-cli CONFIG_DB hgetall "TERTOOS_CLASS_MAP|${name}"&#xA;
        else&#xA;
            sonic-db-cli CONFIG_DB keys 'TERTOOS_CLASS_MAP|*'&#xA;
        fi&#xA;
      </ACTION>
    </COMMAND>
    <COMMAND name="show policy-map" help="Policy-maps">
      <PARAM name="name" help="Policy-map name (optional)" ptype="STRING" optional="true"/>
      <ACTION>
        if [ -n "${name}" ]; then&#xA;
            sonic-db-cli CONFIG_DB keys "TERTOOS_POLICY_MAP_CLASS|${name}|*"&#xA;
        else&#xA;
            sonic-db-cli CONFIG_DB keys 'TERTOOS_POLICY_MAP|*'&#xA;
        fi&#xA;
      </ACTION>
    </COMMAND>
    <COMMAND name="show policy-map interface" help="Per-port service-policy bindings">
      <PARAM name="port" help="Port" ptype="STRING"/>
      <ACTION>sonic-db-cli CONFIG_DB hgetall "TERTOOS_PORT_SERVICE_POLICY|${port}"</ACTION>
    </COMMAND>
    <COMMAND name="show policer" help="Policer profiles">
      <PARAM name="name" help="Policer name (optional)" ptype="STRING" optional="true"/>
      <ACTION>
        if [ -n "${name}" ]; then&#xA;
            sonic-db-cli CONFIG_DB hgetall "POLICER|${name}"&#xA;
        else&#xA;
            sonic-db-cli CONFIG_DB keys 'POLICER|*'&#xA;
        fi&#xA;
      </ACTION>
    </COMMAND>

    <COMMAND name="show qos wred-profile" help="WRED profiles">
      <ACTION>show qos wred-profile 2&gt;/dev/null || sonic-db-cli CONFIG_DB keys 'WRED_PROFILE|*'</ACTION>
    </COMMAND>
    <COMMAND name="show qos buffer-pool" help="Buffer pools">
      <ACTION>show qos buffer-pool 2&gt;/dev/null || sonic-db-cli CONFIG_DB keys 'BUFFER_POOL|*'</ACTION>
    </COMMAND>
    <COMMAND name="show qos buffer-profile" help="Buffer profiles">
      <ACTION>show qos buffer-profile 2&gt;/dev/null || sonic-db-cli CONFIG_DB keys 'BUFFER_PROFILE|*'</ACTION>
    </COMMAND>
    <COMMAND name="show qos buffer-pg" help="Per-port buffer-PG bindings">
      <PARAM name="port" help="Port (e.g. Ethernet0)" ptype="STRING"/>
      <ACTION>sonic-db-cli CONFIG_DB keys "BUFFER_PG|${port}|*"</ACTION>
    </COMMAND>
    <COMMAND name="show qos buffer-queue" help="Per-port buffer-queue bindings">
      <PARAM name="port" help="Port (e.g. Ethernet0)" ptype="STRING"/>
      <ACTION>sonic-db-cli CONFIG_DB keys "BUFFER_QUEUE|${port}|*"</ACTION>
    </COMMAND>

    <COMMAND name="show priority-group counters" help="Per-port priority-group counters">
      <PARAM name="port" help="Port (optional)" ptype="STRING_WITH_PIPE" optional="true"/>
      <ACTION>show priority-group counters ${port}</ACTION>
    </COMMAND>

    <!-- ===== S13.D — OTA image management ================================ -->
    <COMMAND name="image install" help="Install signed image bundle from URL">
      <PARAM name="url" help="https://... bundle URL" ptype="STRING"/>
      <PARAM name="opt" help="no-verify (skip signature) — optional" ptype="STRING" optional="true"/>
      <ACTION>
        if [ "${opt}" = "no-verify" ]; then&#xA;
            tertoos-cli image install ${url} no-verify&#xA;
        else&#xA;
            tertoos-cli image install ${url}&#xA;
        fi&#xA;
      </ACTION>
    </COMMAND>
    <COMMAND name="image activate" help="Set next-boot image">
      <PARAM name="slot" help="next | image-name" ptype="STRING"/>
      <ACTION>tertoos-cli image activate ${slot}</ACTION>
    </COMMAND>
    <COMMAND name="image commit" help="Commit current image as default">
      <ACTION>tertoos-cli image commit</ACTION>
    </COMMAND>
    <COMMAND name="image rollback" help="Roll back to previous image">
      <ACTION>tertoos-cli image rollback</ACTION>
    </COMMAND>
    <COMMAND name="image list" help="List installed images (sonic-installer list)">
      <ACTION>tertoos-cli image list</ACTION>
    </COMMAND>
    <COMMAND name="image verify" help="Verify a bundle's detached signature">
      <PARAM name="path" help="Local bundle path" ptype="STRING"/>
      <ACTION>tertoos-cli image verify ${path}</ACTION>
    </COMMAND>

    <COMMAND name="show horizon status" help="Horizon agent status">
      <ACTION>tertoos-cli horizon status</ACTION>
    </COMMAND>
    <COMMAND name="show horizon telemetry" help="Last telemetry samples">
      <ACTION>tertoos-cli horizon telemetry</ACTION>
    </COMMAND>
    <COMMAND name="show horizon queue" help="Pending publish queue">
      <ACTION>tertoos-cli horizon queue</ACTION>
    </COMMAND>

    <COMMAND name="debug" help="Enable debug for a feature">
      <PARAM name="feature" help="Feature name" ptype="STRING"/>
      <ACTION>tertoos-cli debug enable ${feature}</ACTION>
    </COMMAND>
    <COMMAND name="undebug" help="Disable debug for a feature">
      <PARAM name="feature" help="Feature name" ptype="STRING"/>
      <ACTION>tertoos-cli debug disable ${feature}</ACTION>
    </COMMAND>

    <COMMAND name="terminal length" help="Set terminal pager length">
      <PARAM name="lines" help="Lines per page (0 = no paging)" ptype="UINT"/>
      <ACTION>tertoos-cli terminal length ${lines}</ACTION>
    </COMMAND>

    <!-- ===== Console log control (IOS-XR `terminal monitor`) ================
         Liga/desliga as mensagens de kernel/systemd nesta console serial.
         Util no EVE-NG/console onde o systemd-ssh-generator polui a tela. -->
    <COMMAND name="terminal monitor"
             help="Show kernel/system log messages on this console">
      <ACTION>sudo dmesg -n 7</ACTION>
    </COMMAND>
    <COMMAND name="terminal no monitor"
             help="Silence kernel/system log messages on this console">
      <ACTION>sudo dmesg -n 1</ACTION>
    </COMMAND>

    <!-- ===== Operator shell escape (IOS-XR `run`) ===========================
         bash → shell interativo do sistema; run → um comando unico.
         Fora da maquina de candidate/commit — mudancas aqui nao sao
         rastreadas. -->
    <COMMAND name="bash" help="Drop into the system shell (outside the CLI)">
      <ACTION>bash -l</ACTION>
    </COMMAND>
    <COMMAND name="run" help="Run a single system-shell command">
      <PARAM name="cmd" help="Command line to execute" ptype="STRING_WITH_PIPE"/>
      <ACTION>bash -lc "${cmd}"</ACTION>
    </COMMAND>

    <!--
      Candidate apply/discard from privileged-view. IOS-XR semantics:
      after `end` in config-view the candidate is preserved; operator
      can review (`show configuration`), then `commit` from privileged
      to apply, or `abort` to discard. No-op if no candidate is open.
    -->
    <COMMAND name="commit" help="Apply candidate configuration to running">
      <ACTION>tertoos-cli candidate commit</ACTION>
    </COMMAND>
    <COMMAND name="abort" help="Discard candidate configuration">
      <ACTION>tertoos-cli candidate abort</ACTION>
    </COMMAND>
    <COMMAND name="show configuration"
             help="Show pending candidate changes (diff vs running)">
      <ACTION>tertoos-cli candidate show</ACTION>
    </COMMAND>

    <COMMAND name="rollback configuration last"
             help="Roll back N most recent commits">
      <PARAM name="n" help="Number of commits to roll back" ptype="UINT"/>
      <ACTION>tertoos-cli rollback last ${n}</ACTION>
    </COMMAND>
    <COMMAND name="rollback configuration to"
             help="Roll back to a labeled commit">
      <PARAM name="label" help="Commit label" ptype="STRING"/>
      <ACTION>tertoos-cli rollback to ${label}</ACTION>
    </COMMAND>

  </VIEW>
</CLISH_MODULE>
