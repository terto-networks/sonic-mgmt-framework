<?xml version="1.0" encoding="UTF-8"?>
<!--
  TertoOS — privileged-view ("tertoos#").
  Equivalente IOS-XR: privileged EXEC. Entrada em config via
  "configure" ou "configure terminal".
-->
<CLISH_MODULE
    xmlns="http://www.dellemc.com/sonic/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.dellemc.com/sonic/XMLSchema
                        http://www.dellemc.com/sonic/XMLSchema/clish.xsd">

  <VIEW name="privileged-view" prompt="${SYSTEM_NAME}# ">

    <COMMAND name="disable" help="Return to user EXEC" view="exec-view">
      <ACTION builtin="clish_nop"/>
    </COMMAND>

    <COMMAND name="exit" help="Exit privileged EXEC" view="exec-view">
      <ACTION builtin="clish_nop"/>
    </COMMAND>

    <COMMAND name="logout" help="Exit the CLI" lock="false">
      <ACTION builtin="clish_close"/>
    </COMMAND>

    <!-- Enter configuration (candidate) -->
    <COMMAND name="configure"
             help="Enter global configuration mode"
             view="config-view">
      <ACTION>tertoos-cli candidate begin</ACTION>
    </COMMAND>
    <COMMAND name="configure terminal"
             help="Configure from the terminal"
             view="config-view">
      <ACTION>tertoos-cli candidate begin</ACTION>
    </COMMAND>
    <COMMAND name="configure exclusive"
             help="Configure with exclusive lock"
             view="config-view">
      <ACTION>tertoos-cli candidate begin --exclusive</ACTION>
    </COMMAND>

    <!-- Show family -->
    <COMMAND name="show" help="Display operational state"/>
    <COMMAND name="show version" help="Show TertoOS version">
      <ACTION>tertoos-cli show version</ACTION>
    </COMMAND>
    <COMMAND name="show running-config"
             help="Show running configuration (committed)">
      <ACTION>tertoos-cli show running</ACTION>
    </COMMAND>
    <COMMAND name="show configuration commit list"
             help="List recent commits">
      <ACTION>tertoos-cli commit list</ACTION>
    </COMMAND>
    <COMMAND name="show configuration commit changes"
             help="Show changes of a specific commit">
      <PARAM name="commit-id" help="Commit id (numeric or label)" ptype="STRING"/>
      <ACTION>tertoos-cli commit show ${commit-id}</ACTION>
    </COMMAND>
    <COMMAND name="show interfaces" help="Show interfaces">
      <ACTION>tertoos-cli show interfaces</ACTION>
    </COMMAND>
    <COMMAND name="show ipv4 interface brief" help="IPv4 interface brief">
      <ACTION>tertoos-cli show ipv4 brief</ACTION>
    </COMMAND>
    <COMMAND name="show ipv4 route" help="IPv4 routing table">
      <ACTION>tertoos-cli show ipv4 route</ACTION>
    </COMMAND>
    <COMMAND name="show bgp summary" help="BGP summary">
      <ACTION>vtysh -c "show bgp summary"</ACTION>
    </COMMAND>
    <COMMAND name="show bgp summary vrf" help="BGP summary for a VRF">
      <PARAM name="vrf" help="VRF name" ptype="TERTOOS_NAME"/>
      <ACTION>vtysh -c "show bgp vrf ${vrf} summary"</ACTION>
    </COMMAND>
    <COMMAND name="show bgp neighbors" help="BGP neighbors detail">
      <ACTION>vtysh -c "show bgp neighbors"</ACTION>
    </COMMAND>
    <COMMAND name="show bgp neighbor" help="BGP neighbor detail (single peer)">
      <PARAM name="addr" help="Neighbor address" ptype="STRING"/>
      <ACTION>vtysh -c "show bgp neighbors ${addr}"</ACTION>
    </COMMAND>
    <COMMAND name="show bgp ipv4 unicast" help="BGP IPv4 unicast RIB">
      <ACTION>vtysh -c "show bgp ipv4 unicast"</ACTION>
    </COMMAND>
    <COMMAND name="show bgp ipv4 unicast prefix" help="BGP IPv4 unicast for a prefix">
      <PARAM name="prefix" help="A.B.C.D/M" ptype="TERTOOS_IPV4_PREFIX"/>
      <ACTION>vtysh -c "show bgp ipv4 unicast ${prefix}"</ACTION>
    </COMMAND>
    <COMMAND name="show bgp ipv6 unicast" help="BGP IPv6 unicast RIB">
      <ACTION>vtysh -c "show bgp ipv6 unicast"</ACTION>
    </COMMAND>
    <COMMAND name="show bgp ipv6 unicast prefix" help="BGP IPv6 unicast for a prefix">
      <PARAM name="prefix" help="X:X::X/M" ptype="TERTOOS_IPV6_PREFIX"/>
      <ACTION>vtysh -c "show bgp ipv6 unicast ${prefix}"</ACTION>
    </COMMAND>
    <COMMAND name="show ospf" help="OSPF process info">
      <ACTION>vtysh -c "show ip ospf"</ACTION>
    </COMMAND>
    <COMMAND name="show ospf vrf" help="OSPF info for a VRF">
      <PARAM name="vrf" help="VRF name" ptype="TERTOOS_NAME"/>
      <ACTION>vtysh -c "show ip ospf vrf ${vrf}"</ACTION>
    </COMMAND>
    <COMMAND name="show ospf neighbor" help="OSPF neighbors">
      <ACTION>vtysh -c "show ip ospf neighbor"</ACTION>
    </COMMAND>
    <COMMAND name="show ospf interface" help="OSPF interfaces">
      <ACTION>vtysh -c "show ip ospf interface"</ACTION>
    </COMMAND>
    <COMMAND name="show ospf database" help="OSPF LSDB">
      <ACTION>vtysh -c "show ip ospf database"</ACTION>
    </COMMAND>
    <COMMAND name="show mpls ldp neighbor" help="LDP neighbors">
      <ACTION>vtysh -c "show mpls ldp neighbor"</ACTION>
    </COMMAND>
    <COMMAND name="show mpls ldp binding" help="LDP label bindings">
      <ACTION>vtysh -c "show mpls ldp binding"</ACTION>
    </COMMAND>
    <COMMAND name="show mpls ldp interface" help="LDP enabled interfaces">
      <ACTION>vtysh -c "show mpls ldp interface"</ACTION>
    </COMMAND>
    <COMMAND name="show mpls ldp discovery" help="LDP discovery">
      <ACTION>vtysh -c "show mpls ldp discovery"</ACTION>
    </COMMAND>
    <COMMAND name="show bgp vpnv4 unicast" help="BGP VPNv4 unicast RIB">
      <ACTION>vtysh -c "show bgp vpnv4 unicast"</ACTION>
    </COMMAND>
    <COMMAND name="show bgp vpnv4 unicast vrf" help="BGP VPNv4 unicast for a VRF">
      <PARAM name="vrf" help="VRF name" ptype="TERTOOS_NAME"/>
      <ACTION>vtysh -c "show bgp vpnv4 unicast vrf ${vrf}"</ACTION>
    </COMMAND>
    <COMMAND name="show bgp vpnv6 unicast" help="BGP VPNv6 unicast RIB">
      <ACTION>vtysh -c "show bgp vpnv6 unicast"</ACTION>
    </COMMAND>
    <COMMAND name="show bgp vpnv6 unicast vrf" help="BGP VPNv6 unicast for a VRF">
      <PARAM name="vrf" help="VRF name" ptype="TERTOOS_NAME"/>
      <ACTION>vtysh -c "show bgp vpnv6 unicast vrf ${vrf}"</ACTION>
    </COMMAND>
    <COMMAND name="show l2vpn xconnect" help="L2VPN xconnect status">
      <ACTION>vtysh -c "show l2vpn xconnect"</ACTION>
    </COMMAND>
    <COMMAND name="show mpls l2transport vc" help="MPLS L2 transport VC">
      <ACTION>vtysh -c "show mpls l2transport vc"</ACTION>
    </COMMAND>
    <COMMAND name="show evpn vni" help="EVPN VNI summary">
      <ACTION>vtysh -c "show evpn vni"</ACTION>
    </COMMAND>
    <COMMAND name="show evpn vni detail" help="EVPN VNI detail">
      <PARAM name="vni" help="VNI id" ptype="UINT"/>
      <ACTION>vtysh -c "show evpn vni ${vni}"</ACTION>
    </COMMAND>
    <COMMAND name="show evpn mac vni" help="EVPN MACs for a VNI">
      <PARAM name="vni" help="VNI id" ptype="UINT"/>
      <ACTION>vtysh -c "show evpn mac vni ${vni}"</ACTION>
    </COMMAND>
    <COMMAND name="show evpn arp-cache vni" help="EVPN ARP/ND cache for a VNI">
      <PARAM name="vni" help="VNI id" ptype="UINT"/>
      <ACTION>vtysh -c "show evpn arp-cache vni ${vni}"</ACTION>
    </COMMAND>
    <COMMAND name="show evpn es" help="EVPN ethernet-segments">
      <ACTION>vtysh -c "show evpn es"</ACTION>
    </COMMAND>
    <COMMAND name="show bgp l2vpn evpn" help="BGP L2VPN EVPN RIB">
      <ACTION>vtysh -c "show bgp l2vpn evpn"</ACTION>
    </COMMAND>
    <COMMAND name="show platform" help="Platform information">
      <ACTION>tertoos-cli show platform</ACTION>
    </COMMAND>
    <COMMAND name="show tech-support" help="Collect tech-support bundle">
      <ACTION>tertoos-cli tech-support</ACTION>
    </COMMAND>

    <!-- Operational -->
    <COMMAND name="ping" help="Ping IPv4/IPv6 host">
      <PARAM name="target" help="Hostname or IP" ptype="STRING"/>
      <ACTION>ping -c 4 ${target}</ACTION>
    </COMMAND>
    <COMMAND name="traceroute" help="Trace route to host">
      <PARAM name="target" help="Hostname or IP" ptype="STRING"/>
      <ACTION>traceroute ${target}</ACTION>
    </COMMAND>
    <COMMAND name="ssh" help="Open SSH session">
      <PARAM name="target" help="user@host" ptype="STRING"/>
      <ACTION>ssh ${target}</ACTION>
    </COMMAND>

    <COMMAND name="reload" help="Reload the system">
      <ACTION>tertoos-cli reload</ACTION>
    </COMMAND>
    <COMMAND name="clear" help="Reset operational counters/state"/>
    <COMMAND name="clear counters" help="Clear interface counters">
      <ACTION>tertoos-cli clear counters</ACTION>
    </COMMAND>
    <COMMAND name="clear bgp" help="Reset all BGP sessions">
      <ACTION>vtysh -c "clear bgp *"</ACTION>
    </COMMAND>
    <COMMAND name="clear bgp neighbor" help="Reset a specific BGP neighbor">
      <PARAM name="addr" help="Neighbor address" ptype="STRING"/>
      <ACTION>vtysh -c "clear bgp ${addr}"</ACTION>
    </COMMAND>
    <COMMAND name="clear bgp neighbor soft" help="Soft-clear a BGP neighbor">
      <PARAM name="addr" help="Neighbor address" ptype="STRING"/>
      <PARAM name="dir" help="in | out" ptype="STRING"/>
      <ACTION>vtysh -c "clear bgp ${addr} soft ${dir}"</ACTION>
    </COMMAND>
    <COMMAND name="clear bgp vrf" help="Reset BGP sessions in a VRF">
      <PARAM name="vrf" help="VRF name" ptype="TERTOOS_NAME"/>
      <ACTION>vtysh -c "clear bgp vrf ${vrf} *"</ACTION>
    </COMMAND>
    <COMMAND name="clear ip ospf process" help="Reset the OSPF process">
      <ACTION>vtysh -c "clear ip ospf process"</ACTION>
    </COMMAND>
    <COMMAND name="clear mpls ldp neighbor" help="Reset all LDP neighbors">
      <ACTION>vtysh -c "clear mpls ldp neighbor *"</ACTION>
    </COMMAND>
    <COMMAND name="clear mpls ldp neighbor peer" help="Reset specific LDP neighbor">
      <PARAM name="addr" help="Peer LSR-id" ptype="STRING"/>
      <ACTION>vtysh -c "clear mpls ldp neighbor ${addr}"</ACTION>
    </COMMAND>
    <COMMAND name="clear evpn dup-addr" help="Clear EVPN duplicate-address detection state">
      <ACTION>vtysh -c "clear evpn dup-addr"</ACTION>
    </COMMAND>
    <COMMAND name="clear bgp l2vpn evpn" help="Reset all BGP L2VPN EVPN sessions">
      <ACTION>vtysh -c "clear bgp l2vpn evpn *"</ACTION>
    </COMMAND>
    <COMMAND name="clear bfd statistics" help="Reset BFD counters">
      <ACTION>vtysh -c "clear bfd statistics"</ACTION>
    </COMMAND>
    <COMMAND name="show bfd peers" help="BFD peers state">
      <ACTION>vtysh -c "show bfd peers"</ACTION>
    </COMMAND>
    <COMMAND name="show bfd peers brief" help="BFD peers brief">
      <ACTION>vtysh -c "show bfd peers brief"</ACTION>
    </COMMAND>
    <COMMAND name="show sflow" help="sFlow status">
      <ACTION>show sflow</ACTION>
    </COMMAND>
    <COMMAND name="show lldp neighbors" help="LLDP neighbors">
      <ACTION>show lldp neighbors</ACTION>
    </COMMAND>
    <COMMAND name="show lldp table" help="LLDP table">
      <ACTION>show lldp table</ACTION>
    </COMMAND>
    <COMMAND name="show ntp associations" help="NTP associations">
      <ACTION>chronyc sources -v 2&gt;/dev/null || ntpq -p</ACTION>
    </COMMAND>
    <COMMAND name="show ntp status" help="NTP status">
      <ACTION>chronyc tracking 2&gt;/dev/null || ntpq -nc rv</ACTION>
    </COMMAND>
    <COMMAND name="show logging" help="Recent log messages">
      <ACTION>tail -200 /var/log/syslog 2&gt;/dev/null || journalctl -n 200 --no-pager</ACTION>
    </COMMAND>
    <COMMAND name="show snmp" help="SNMP runtime config">
      <ACTION>show runningconfiguration snmp 2&gt;/dev/null</ACTION>
    </COMMAND>
    <COMMAND name="show telemetry" help="Telemetry/gNMI status">
      <ACTION>systemctl status telemetry 2&gt;/dev/null | head -10</ACTION>
    </COMMAND>
    <COMMAND name="show ssh server" help="SSH server config">
      <ACTION>grep -E '^(Port|PermitRootLogin|Protocol)' /etc/ssh/sshd_config 2&gt;/dev/null</ACTION>
    </COMMAND>

    <COMMAND name="debug" help="Enable debug for a feature">
      <PARAM name="feature" help="Feature name" ptype="STRING"/>
      <ACTION>tertoos-cli debug enable ${feature}</ACTION>
    </COMMAND>
    <COMMAND name="undebug" help="Disable debug for a feature">
      <PARAM name="feature" help="Feature name" ptype="STRING"/>
      <ACTION>tertoos-cli debug disable ${feature}</ACTION>
    </COMMAND>

    <COMMAND name="terminal length" help="Set terminal pager length">
      <PARAM name="lines" help="Lines per page (0 = no paging)" ptype="UINT"/>
      <ACTION>tertoos-cli terminal length ${lines}</ACTION>
    </COMMAND>

  </VIEW>
</CLISH_MODULE>
