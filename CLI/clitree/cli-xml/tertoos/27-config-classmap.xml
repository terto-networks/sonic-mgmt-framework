<?xml version="1.0" encoding="UTF-8"?>
<!--
  TertoOS — class-map view (S12.B.3, IOS-XR style).
    class-map type qos|traffic match-any|all <name>
      match dscp <list>
      match precedence <n>
      match cos <n>
      match traffic-class <n>
      match access-group ipv4|ipv6 <acl>
  Mapeia para TERTOOS_CLASS_MAP|<name>. Compilador para ACL_RULE
  fica em S12.B.4 (tertoos-qoscompd).
-->
<CLISH_MODULE
    xmlns="http://www.dellemc.com/sonic/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.dellemc.com/sonic/XMLSchema
                        http://www.dellemc.com/sonic/XMLSchema/clish.xsd">

  <VIEW name="config-view">
    <COMMAND name="class-map type qos match-any"
             help="Configure class-map (QoS, match-any)"
             view="config-class-map-view"
             viewid="cmapname=${name};cmaptype=qos;cmapop=any">
      <PARAM name="name" help="Class-map name" ptype="TERTOOS_NAME"/>
      <ACTION>
        tertoos-cli candidate context class-map ${name}&#xA;
        tertoos-cli candidate set class-map/${name}/match_type qos&#xA;
        tertoos-cli candidate set class-map/${name}/operator any&#xA;
      </ACTION>
    </COMMAND>
    <COMMAND name="class-map type qos match-all"
             help="Configure class-map (QoS, match-all)"
             view="config-class-map-view"
             viewid="cmapname=${name};cmaptype=qos;cmapop=all">
      <PARAM name="name" help="Class-map name" ptype="TERTOOS_NAME"/>
      <ACTION>
        tertoos-cli candidate context class-map ${name}&#xA;
        tertoos-cli candidate set class-map/${name}/match_type qos&#xA;
        tertoos-cli candidate set class-map/${name}/operator all&#xA;
      </ACTION>
    </COMMAND>
    <COMMAND name="class-map type traffic match-any"
             help="Configure class-map (traffic)"
             view="config-class-map-view"
             viewid="cmapname=${name};cmaptype=traffic;cmapop=any">
      <PARAM name="name" help="Class-map name" ptype="TERTOOS_NAME"/>
      <ACTION>
        tertoos-cli candidate context class-map ${name}&#xA;
        tertoos-cli candidate set class-map/${name}/match_type traffic&#xA;
        tertoos-cli candidate set class-map/${name}/operator any&#xA;
      </ACTION>
    </COMMAND>
    <COMMAND name="no class-map" help="Remove class-map">
      <PARAM name="name" help="Class-map name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate delete class-map/${name}</ACTION>
    </COMMAND>
  </VIEW>

  <VIEW name="config-class-map-view"
        prompt="${SYSTEM_NAME}(config-class-map-${cmapname})# ">
    <COMMAND name="exit" help="exit" view="config-view"><ACTION>tertoos-cli candidate context pop</ACTION></COMMAND>
    <COMMAND name="end" help="end" view="privileged-view"><ACTION>tertoos-cli candidate end</ACTION></COMMAND>

    <COMMAND name="match dscp" help="Match DSCP value(s) (CSV accepted)">
      <PARAM name="v" help="0..63 (e.g. 46 or 46,47,48)" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set class-map/${cmapname}/match_dscp ${v}</ACTION>
    </COMMAND>
    <COMMAND name="match precedence" help="Match IP precedence">
      <PARAM name="v" help="0..7 (e.g. 5 or 5,6)" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set class-map/${cmapname}/match_precedence ${v}</ACTION>
    </COMMAND>
    <COMMAND name="match cos" help="Match dot1p CoS">
      <PARAM name="v" help="0..7" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set class-map/${cmapname}/match_cos ${v}</ACTION>
    </COMMAND>
    <COMMAND name="match traffic-class" help="Match traffic class">
      <PARAM name="v" help="0..7" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set class-map/${cmapname}/match_traffic_class ${v}</ACTION>
    </COMMAND>
    <COMMAND name="match access-group ipv4" help="Match IPv4 ACL">
      <PARAM name="acl" help="ACL name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate set class-map/${cmapname}/match_access_group_v4 ${acl}</ACTION>
    </COMMAND>
    <COMMAND name="match access-group ipv6" help="Match IPv6 ACL">
      <PARAM name="acl" help="ACL name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate set class-map/${cmapname}/match_access_group_v6 ${acl}</ACTION>
    </COMMAND>
  </VIEW>
</CLISH_MODULE>
