<?xml version="1.0" encoding="UTF-8"?>
<!--
  TertoOS — QoS views (S12.B).
  Mapeamento bare-minimum para o pipeline SAI via SONiC qosorch:
    qos map dscp-to-tc <name>   → DSCP_TO_TC_MAP|<name>
    qos map tc-to-queue <name>  → TC_TO_QUEUE_MAP|<name>
    qos map tc-to-pg <name>     → TC_TO_PRIORITY_GROUP_MAP|<name>
    qos scheduler <name>        → SCHEDULER|<name>
  Bind por interface vive em 04-config-interface.xml (PORT_QOS_MAP|<if>).
  Class-map XR completo (match ACL/police/shape/WRED) fica para S12.B.2.
-->
<CLISH_MODULE
    xmlns="http://www.dellemc.com/sonic/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.dellemc.com/sonic/XMLSchema
                        http://www.dellemc.com/sonic/XMLSchema/clish.xsd">

  <VIEW name="config-view">
    <COMMAND name="qos map dscp-to-tc"
             help="Configure DSCP→TC map"
             view="config-qos-dscp-tc-view"
             viewid="qosmap=${name}">
      <PARAM name="name" help="Map name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate context qos-dscp-tc ${name}</ACTION>
    </COMMAND>
    <COMMAND name="no qos map dscp-to-tc" help="Remove DSCP→TC map">
      <PARAM name="name" help="Map name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate delete qos/dscp-to-tc/${name}</ACTION>
    </COMMAND>

    <COMMAND name="qos map tc-to-queue"
             help="Configure TC→Queue map"
             view="config-qos-tc-queue-view"
             viewid="qosmap=${name}">
      <PARAM name="name" help="Map name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate context qos-tc-queue ${name}</ACTION>
    </COMMAND>
    <COMMAND name="no qos map tc-to-queue" help="Remove TC→Queue map">
      <PARAM name="name" help="Map name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate delete qos/tc-to-queue/${name}</ACTION>
    </COMMAND>

    <COMMAND name="qos map tc-to-pg"
             help="Configure TC→Priority-Group map"
             view="config-qos-tc-pg-view"
             viewid="qosmap=${name}">
      <PARAM name="name" help="Map name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate context qos-tc-pg ${name}</ACTION>
    </COMMAND>
    <COMMAND name="no qos map tc-to-pg" help="Remove TC→PG map">
      <PARAM name="name" help="Map name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate delete qos/tc-to-pg/${name}</ACTION>
    </COMMAND>

    <COMMAND name="qos scheduler"
             help="Configure scheduler profile"
             view="config-qos-scheduler-view"
             viewid="schedname=${name}">
      <PARAM name="name" help="Scheduler name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate context qos-scheduler ${name}</ACTION>
    </COMMAND>
    <COMMAND name="no qos scheduler" help="Remove scheduler profile">
      <PARAM name="name" help="Scheduler name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate delete qos/scheduler/${name}</ACTION>
    </COMMAND>

    <!-- ===== S12.B.2 — WRED + Buffer Pool/Profile ========================= -->
    <COMMAND name="wred-profile"
             help="Configure WRED profile (congestion avoidance)"
             view="config-qos-wred-view"
             viewid="wredname=${name}">
      <PARAM name="name" help="WRED profile name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate context qos-wred ${name}</ACTION>
    </COMMAND>
    <COMMAND name="no wred-profile" help="Remove WRED profile">
      <PARAM name="name" help="WRED profile name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate delete qos/wred-profile/${name}</ACTION>
    </COMMAND>

    <COMMAND name="buffer-pool"
             help="Configure buffer pool"
             view="config-qos-buffer-pool-view"
             viewid="poolname=${name}">
      <PARAM name="name" help="Buffer pool name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate context qos-buffer-pool ${name}</ACTION>
    </COMMAND>
    <COMMAND name="no buffer-pool" help="Remove buffer pool">
      <PARAM name="name" help="Buffer pool name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate delete qos/buffer-pool/${name}</ACTION>
    </COMMAND>

    <COMMAND name="buffer-profile"
             help="Configure buffer profile"
             view="config-qos-buffer-profile-view"
             viewid="profname=${name}">
      <PARAM name="name" help="Buffer profile name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate context qos-buffer-profile ${name}</ACTION>
    </COMMAND>
    <COMMAND name="no buffer-profile" help="Remove buffer profile">
      <PARAM name="name" help="Buffer profile name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate delete qos/buffer-profile/${name}</ACTION>
    </COMMAND>
  </VIEW>

  <!-- ============================================================== -->
  <!-- WRED profile leaves                                            -->
  <!-- ============================================================== -->
  <VIEW name="config-qos-wred-view"
        prompt="${SYSTEM_NAME}(config-qos-wred-${wredname})# ">
    <COMMAND name="exit" help="exit" view="config-view"><ACTION>tertoos-cli candidate context pop</ACTION></COMMAND>
    <COMMAND name="end" help="end" view="privileged-view"><ACTION>tertoos-cli candidate end</ACTION></COMMAND>

    <COMMAND name="ecn" help="ECN marking mode">
      <PARAM name="m" help="ecn_none|ecn_green|ecn_yellow|ecn_red|ecn_green_yellow|ecn_green_red|ecn_yellow_red|ecn_all" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set qos/wred-profile/${wredname}/ecn ${m}</ACTION>
    </COMMAND>

    <COMMAND name="green min-threshold" help="Green min threshold (bytes)">
      <PARAM name="b" help="bytes" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/wred-profile/${wredname}/green_min_threshold ${b}</ACTION>
    </COMMAND>
    <COMMAND name="green max-threshold" help="Green max threshold (bytes)">
      <PARAM name="b" help="bytes" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/wred-profile/${wredname}/green_max_threshold ${b}</ACTION>
    </COMMAND>
    <COMMAND name="green drop-probability" help="Green drop probability %">
      <PARAM name="p" help="0..100" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/wred-profile/${wredname}/green_drop_probability ${p}</ACTION>
    </COMMAND>

    <COMMAND name="yellow min-threshold" help="Yellow min threshold (bytes)">
      <PARAM name="b" help="bytes" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/wred-profile/${wredname}/yellow_min_threshold ${b}</ACTION>
    </COMMAND>
    <COMMAND name="yellow max-threshold" help="Yellow max threshold (bytes)">
      <PARAM name="b" help="bytes" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/wred-profile/${wredname}/yellow_max_threshold ${b}</ACTION>
    </COMMAND>
    <COMMAND name="yellow drop-probability" help="Yellow drop probability %">
      <PARAM name="p" help="0..100" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/wred-profile/${wredname}/yellow_drop_probability ${p}</ACTION>
    </COMMAND>

    <COMMAND name="red min-threshold" help="Red min threshold (bytes)">
      <PARAM name="b" help="bytes" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/wred-profile/${wredname}/red_min_threshold ${b}</ACTION>
    </COMMAND>
    <COMMAND name="red max-threshold" help="Red max threshold (bytes)">
      <PARAM name="b" help="bytes" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/wred-profile/${wredname}/red_max_threshold ${b}</ACTION>
    </COMMAND>
    <COMMAND name="red drop-probability" help="Red drop probability %">
      <PARAM name="p" help="0..100" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/wred-profile/${wredname}/red_drop_probability ${p}</ACTION>
    </COMMAND>

    <COMMAND name="wred enable" help="Enable WRED for a color">
      <PARAM name="c" help="green | yellow | red" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set qos/wred-profile/${wredname}/wred_${c}_enable true</ACTION>
    </COMMAND>
    <COMMAND name="wred disable" help="Disable WRED for a color">
      <PARAM name="c" help="green | yellow | red" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set qos/wred-profile/${wredname}/wred_${c}_enable false</ACTION>
    </COMMAND>
  </VIEW>

  <!-- ============================================================== -->
  <!-- Buffer Pool leaves                                             -->
  <!-- ============================================================== -->
  <VIEW name="config-qos-buffer-pool-view"
        prompt="${SYSTEM_NAME}(config-qos-buffer-pool-${poolname})# ">
    <COMMAND name="exit" help="exit" view="config-view"><ACTION>tertoos-cli candidate context pop</ACTION></COMMAND>
    <COMMAND name="end" help="end" view="privileged-view"><ACTION>tertoos-cli candidate end</ACTION></COMMAND>

    <COMMAND name="type" help="Pool direction">
      <PARAM name="t" help="ingress | egress" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set qos/buffer-pool/${poolname}/type ${t}</ACTION>
    </COMMAND>
    <COMMAND name="mode" help="Pool admission mode">
      <PARAM name="m" help="static | dynamic" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set qos/buffer-pool/${poolname}/mode ${m}</ACTION>
    </COMMAND>
    <COMMAND name="size" help="Pool size in bytes">
      <PARAM name="b" help="bytes" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/buffer-pool/${poolname}/size ${b}</ACTION>
    </COMMAND>
    <COMMAND name="xoff" help="Pool-level xoff threshold">
      <PARAM name="b" help="bytes" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/buffer-pool/${poolname}/xoff ${b}</ACTION>
    </COMMAND>
  </VIEW>

  <!-- ============================================================== -->
  <!-- Buffer Profile leaves                                          -->
  <!-- ============================================================== -->
  <VIEW name="config-qos-buffer-profile-view"
        prompt="${SYSTEM_NAME}(config-qos-buffer-profile-${profname})# ">
    <COMMAND name="exit" help="exit" view="config-view"><ACTION>tertoos-cli candidate context pop</ACTION></COMMAND>
    <COMMAND name="end" help="end" view="privileged-view"><ACTION>tertoos-cli candidate end</ACTION></COMMAND>

    <COMMAND name="pool" help="Bind to a buffer pool">
      <PARAM name="p" help="Pool name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate set qos/buffer-profile/${profname}/pool ${p}</ACTION>
    </COMMAND>
    <COMMAND name="size" help="Reserved size (bytes)">
      <PARAM name="b" help="bytes" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/buffer-profile/${profname}/size ${b}</ACTION>
    </COMMAND>
    <COMMAND name="static-th" help="Static threshold (bytes)">
      <PARAM name="b" help="bytes" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/buffer-profile/${profname}/static_th ${b}</ACTION>
    </COMMAND>
    <COMMAND name="dynamic-th" help="Dynamic alpha (-8..7)">
      <PARAM name="a" help="-8..7" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set qos/buffer-profile/${profname}/dynamic_th ${a}</ACTION>
    </COMMAND>
    <COMMAND name="xon" help="Xon threshold (bytes)">
      <PARAM name="b" help="bytes" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/buffer-profile/${profname}/xon ${b}</ACTION>
    </COMMAND>
    <COMMAND name="xon-offset" help="Xon offset (bytes)">
      <PARAM name="b" help="bytes" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/buffer-profile/${profname}/xon_offset ${b}</ACTION>
    </COMMAND>
    <COMMAND name="xoff" help="Xoff threshold (bytes)">
      <PARAM name="b" help="bytes" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/buffer-profile/${profname}/xoff ${b}</ACTION>
    </COMMAND>
    <COMMAND name="headroom-type" help="Headroom calc strategy">
      <PARAM name="t" help="static | dynamic" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set qos/buffer-profile/${profname}/headroom_type ${t}</ACTION>
    </COMMAND>
    <COMMAND name="packet-discard-action" help="Discard action">
      <PARAM name="a" help="drop | trim" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set qos/buffer-profile/${profname}/packet_discard_action ${a}</ACTION>
    </COMMAND>
  </VIEW>

  <!-- ============================================================== -->
  <!-- DSCP → TC map entries                                          -->
  <!-- ============================================================== -->
  <VIEW name="config-qos-dscp-tc-view"
        prompt="${SYSTEM_NAME}(config-qos-dscp-tc-${qosmap})# ">
    <COMMAND name="exit" help="exit" view="config-view"><ACTION>tertoos-cli candidate context pop</ACTION></COMMAND>
    <COMMAND name="end" help="end" view="privileged-view"><ACTION>tertoos-cli candidate end</ACTION></COMMAND>

    <COMMAND name="dscp" help="DSCP code-point → traffic-class">
      <PARAM name="dscp" help="DSCP value 0..63" ptype="UINT"/>
      <PARAM name="tc_kw" help="traffic-class" ptype="SUBCOMMAND" mode="subcommand" value="traffic-class"/>
      <PARAM name="tc" help="Traffic class 0..7" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/dscp-to-tc/${qosmap}/${dscp} ${tc}</ACTION>
    </COMMAND>
    <COMMAND name="no dscp" help="Remove DSCP entry">
      <PARAM name="dscp" help="DSCP value 0..63" ptype="UINT"/>
      <ACTION>tertoos-cli candidate delete qos/dscp-to-tc/${qosmap}/${dscp}</ACTION>
    </COMMAND>
  </VIEW>

  <!-- ============================================================== -->
  <!-- TC → Queue map entries                                         -->
  <!-- ============================================================== -->
  <VIEW name="config-qos-tc-queue-view"
        prompt="${SYSTEM_NAME}(config-qos-tc-queue-${qosmap})# ">
    <COMMAND name="exit" help="exit" view="config-view"><ACTION>tertoos-cli candidate context pop</ACTION></COMMAND>
    <COMMAND name="end" help="end" view="privileged-view"><ACTION>tertoos-cli candidate end</ACTION></COMMAND>

    <COMMAND name="tc" help="Traffic-class → queue">
      <PARAM name="tc" help="Traffic class 0..7" ptype="UINT"/>
      <PARAM name="q_kw" help="queue" ptype="SUBCOMMAND" mode="subcommand" value="queue"/>
      <PARAM name="q" help="Queue index 0..7" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/tc-to-queue/${qosmap}/${tc} ${q}</ACTION>
    </COMMAND>
    <COMMAND name="no tc" help="Remove TC entry">
      <PARAM name="tc" help="Traffic class 0..7" ptype="UINT"/>
      <ACTION>tertoos-cli candidate delete qos/tc-to-queue/${qosmap}/${tc}</ACTION>
    </COMMAND>
  </VIEW>

  <!-- ============================================================== -->
  <!-- TC → Priority-Group map entries                                -->
  <!-- ============================================================== -->
  <VIEW name="config-qos-tc-pg-view"
        prompt="${SYSTEM_NAME}(config-qos-tc-pg-${qosmap})# ">
    <COMMAND name="exit" help="exit" view="config-view"><ACTION>tertoos-cli candidate context pop</ACTION></COMMAND>
    <COMMAND name="end" help="end" view="privileged-view"><ACTION>tertoos-cli candidate end</ACTION></COMMAND>

    <COMMAND name="tc" help="Traffic-class → priority-group">
      <PARAM name="tc" help="Traffic class 0..7" ptype="UINT"/>
      <PARAM name="pg_kw" help="pg" ptype="SUBCOMMAND" mode="subcommand" value="pg"/>
      <PARAM name="pg" help="Priority-group 0..7" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/tc-to-pg/${qosmap}/${tc} ${pg}</ACTION>
    </COMMAND>
    <COMMAND name="no tc" help="Remove TC entry">
      <PARAM name="tc" help="Traffic class 0..7" ptype="UINT"/>
      <ACTION>tertoos-cli candidate delete qos/tc-to-pg/${qosmap}/${tc}</ACTION>
    </COMMAND>
  </VIEW>

  <!-- ============================================================== -->
  <!-- Scheduler profile leaves                                       -->
  <!-- ============================================================== -->
  <VIEW name="config-qos-scheduler-view"
        prompt="${SYSTEM_NAME}(config-qos-scheduler-${schedname})# ">
    <COMMAND name="exit" help="exit" view="config-view"><ACTION>tertoos-cli candidate context pop</ACTION></COMMAND>
    <COMMAND name="end" help="end" view="privileged-view"><ACTION>tertoos-cli candidate end</ACTION></COMMAND>

    <COMMAND name="type" help="Scheduling discipline">
      <PARAM name="t" help="DWRR | STRICT | WRR" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set qos/scheduler/${schedname}/type ${t}</ACTION>
    </COMMAND>
    <COMMAND name="weight" help="DWRR/WRR weight (1..100)">
      <PARAM name="w" help="1..100" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/scheduler/${schedname}/weight ${w}</ACTION>
    </COMMAND>
    <COMMAND name="meter-type" help="Rate meter unit">
      <PARAM name="u" help="bytes | packets" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set qos/scheduler/${schedname}/meter_type ${u}</ACTION>
    </COMMAND>
    <COMMAND name="cir" help="Committed rate / min-bandwidth garantida (kbps)">
      <PARAM name="kbps" help="Rate in kbps" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/scheduler/${schedname}/cir ${kbps}</ACTION>
    </COMMAND>
    <COMMAND name="pir" help="Peak rate / teto (kbps)">
      <PARAM name="kbps" help="Rate in kbps" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/scheduler/${schedname}/pir ${kbps}</ACTION>
    </COMMAND>
    <COMMAND name="pbs" help="Peak burst size">
      <PARAM name="bytes" help="Burst in bytes" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set qos/scheduler/${schedname}/pbs ${bytes}</ACTION>
    </COMMAND>
  </VIEW>
</CLISH_MODULE>
