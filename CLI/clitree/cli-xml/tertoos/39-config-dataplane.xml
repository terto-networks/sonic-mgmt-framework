<?xml version="1.0" encoding="UTF-8"?>
<!--
  TertoOS — opções globais do dataplane.
    YANG: tertoos-dataplane-extensions.yang (DATAPLANE_GLOBAL).

    dataplane hitless-restart <mode>  → DATAPLANE_GLOBAL|global hitless_restart
    dataplane forwarding-profile <p>  → DATAPLANE_GLOBAL|global forwarding_profile

  forwarding-profile = QUAL produto a caixa é (decisão CEO 2026-10-01):
    aggregation  (default) MPLS/LDP/SR-MPLS, PWs, EVPN-MPLS, L3VPN — sem EVPN-VXLAN
    datacenter   EVPN-VXLAN sobre underlay IP — sem MPLS
    unrestricted os dois — SÓ laboratório, não suportado em produção
  O commit recusa config do outro perfil; vale a partir do próximo reload.

  O modo de punt é escolhido quando o dataplane sobe, então mudar isto vale a
  partir do próximo restart do tos-lite-saibridge. O modo REALMENTE em uso
  agora se vê com `show dataplane` (que lê punt_mode/punt_degraded do /healthz
  do saibridge em 127.0.0.1:7651); a mesma informação está na linha de resumo
  que o dataplane loga no start.

  ATENÇÃO ao que isto NÃO é: hitless restart vale para o restart do PROCESSO,
  não para upgrade de imagem — o reload troca o kernel e é boot frio em
  qualquer modo. Freio de emergência independente da config: o arquivo
  /data/no-knet força o modo tap.
-->
<CLISH_MODULE
    xmlns="http://www.dellemc.com/sonic/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.dellemc.com/sonic/XMLSchema
                        http://www.dellemc.com/sonic/XMLSchema/clish.xsd">
  <VIEW name="config-view">
    <COMMAND name="dataplane hitless-restart"
             help="Keep traffic forwarding across a restart of the dataplane bridge">
      <PARAM name="mode" help="disabled | preferred | required"
             ptype="TERTOOS_HITLESS_RESTART"/>
      <ACTION>tertoos-cli candidate set dataplane/hitless_restart ${mode}</ACTION>
    </COMMAND>
    <COMMAND name="no dataplane hitless-restart"
             help="Restore the default (disabled: userspace tap netdevs)">
      <ACTION>tertoos-cli candidate delete dataplane/hitless_restart</ACTION>
    </COMMAND>
    <COMMAND name="dataplane forwarding-profile"
             help="Product profile of the box: aggregation (MPLS) or datacenter (EVPN-VXLAN); applies on next reload">
      <PARAM name="profile" help="aggregation | datacenter | unrestricted (lab only)"
             ptype="TERTOOS_FORWARDING_PROFILE"/>
      <ACTION>tertoos-cli candidate set dataplane/forwarding_profile ${profile}</ACTION>
    </COMMAND>
    <COMMAND name="no dataplane forwarding-profile"
             help="Restore the default forwarding profile (aggregation)">
      <ACTION>tertoos-cli candidate delete dataplane/forwarding_profile</ACTION>
    </COMMAND>
  </VIEW>
</CLISH_MODULE>
