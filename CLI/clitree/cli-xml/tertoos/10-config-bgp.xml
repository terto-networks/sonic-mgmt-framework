    </COMMAND>
    <COMMAND name="address-family vpnv4 unicast"
             help="Per-neighbor VPNv4 unicast (L3VPN)"
             view="config-router-bgp-nbr-af-view"
             viewid="bgpvrf=${bgpvrf};bgpnbr=${bgpnbr};bgpaf=vpnv4_unicast">
