    </COMMAND>
    <COMMAND name="address-family vpnv6 unicast"
             help="Per-neighbor VPNv6 unicast (L3VPN)"
             view="config-router-bgp-nbr-af-view"
             viewid="bgpvrf=${bgpvrf};bgpnbr=${bgpnbr};bgpaf=vpnv6_unicast">
