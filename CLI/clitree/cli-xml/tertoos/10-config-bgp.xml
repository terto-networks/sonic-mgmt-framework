    </COMMAND>
    <COMMAND name="address-family ipv6 unicast"
             help="Per-neighbor IPv6 unicast"
             view="config-router-bgp-nbr-af-view"
             viewid="bgpvrf=${bgpvrf};bgpnbr=${bgpnbr};bgpaf=ipv6_unicast">
