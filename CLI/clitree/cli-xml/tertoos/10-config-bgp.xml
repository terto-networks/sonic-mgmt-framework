  <VIEW name="config-router-bgp-nbr-view"
        prompt="${SYSTEM_NAME}(config-router-bgp-nbr-${bgpnbr})# ">

    <COMMAND name="exit" help="Exit neighbor" view="config-router-bgp-view">
      <ACTION>tertoos-cli candidate context pop</ACTION>
