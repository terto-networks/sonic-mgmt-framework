        tertoos-cli candidate context router-bgp-nbr-af vpnv6_unicast
        tertoos-cli candidate set bgp/${bgpvrf}/neighbor/${bgpnbr}/af/vpnv6_unicast
      </ACTION>
    </COMMAND>
    <COMMAND name="address-family l2vpn evpn"
             help="Per-neighbor L2VPN EVPN"
             view="config-router-bgp-nbr-af-view"
             viewid="bgpvrf=${bgpvrf};bgpnbr=${bgpnbr};bgpaf=l2vpn_evpn">
