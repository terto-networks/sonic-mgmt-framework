<?xml version="1.0" encoding="UTF-8"?>
<!--
  TertoOS — types (PTYPE) compartilhados entre todas as views IOS-XR.
  Centralizar regex aqui evita divergência entre módulos.
-->
<CLISH_MODULE
    xmlns="http://www.dellemc.com/sonic/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.dellemc.com/sonic/XMLSchema
                        http://www.dellemc.com/sonic/XMLSchema/clish.xsd">

  <!-- AS number 1..4294967295 (4-byte ASN) -->
  <PTYPE name="TERTOOS_ASN"
         method="regexp"
         pattern="([1-9][0-9]{0,9})|([1-9][0-9]{0,4}\.[0-9]+)"
         help="AS number (1-4294967295) or asdot (X.Y)"/>

  <!-- IS-IS NET: 49.0001.aabb.ccdd.eeff.00 -->
  <PTYPE name="TERTOOS_ISIS_NET"
         method="regexp"
         pattern="[0-9a-fA-F]{2}(\.[0-9a-fA-F]{4}){3,9}\.00"
         help="IS-IS NET (e.g. 49.0001.0000.0000.0001.00)"/>

  <!-- MPLS label 16..1048575 (reserved 0-15 excluded) -->
  <PTYPE name="TERTOOS_MPLS_LABEL"
         method="regexp"
         pattern="(1[6-9])|([2-9][0-9])|([1-9][0-9]{2,5})|(10[0-3][0-9]{4})|(104[0-7][0-9]{3})|(1048[0-4][0-9]{2})|(10485[0-6][0-9])|(104857[0-5])"
         help="MPLS label 16..1048575"/>

  <!-- Bundle-Ether id -->
  <PTYPE name="TERTOOS_BUNDLE_ID"
         method="regexp"
         pattern="[1-9][0-9]{0,3}"
         help="Bundle-Ether id 1..9999"/>

  <!-- Route Distinguisher: ASN:nn or A.B.C.D:nn -->
  <PTYPE name="TERTOOS_RD"
         method="regexp"
         pattern="([0-9]+:[0-9]+)|([0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]+)"
         help="Route Distinguisher (ASN:nn or IP:nn)"/>

  <!-- Route Target same shape as RD -->
  <PTYPE name="TERTOOS_RT"
         method="regexp"
         pattern="([0-9]+:[0-9]+)|([0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]+)"
         help="Route Target"/>

  <!-- VLAN id 1..4094 -->
  <PTYPE name="TERTOOS_VLAN_ID"
         method="regexp"
         pattern="([1-9])|([1-9][0-9]{1,2})|([1-3][0-9]{3})|(40[0-8][0-9])|(409[0-4])"
         help="VLAN id 1..4094"/>

  <!-- Identifier (name) -->
  <PTYPE name="TERTOOS_NAME"
         method="regexp"
         pattern="[A-Za-z][A-Za-z0-9_\-]{0,63}"
         help="Identifier (alpha first, 1..64 chars)"/>

  <!-- IPv4 prefix -->
  <PTYPE name="TERTOOS_IPV4_PREFIX"
         method="regexp"
         pattern="([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[1-2][0-9]|3[0-2])"
         help="IPv4 prefix A.B.C.D/M"/>

  <!-- IPv6 prefix (lax — full validation in YANG) -->
  <PTYPE name="TERTOOS_IPV6_PREFIX"
         method="regexp"
         pattern="[0-9a-fA-F:]+/([0-9]|[1-9][0-9]|1[0-1][0-9]|12[0-8])"
         help="IPv6 prefix X:X::X/M"/>

  <!-- S15 — MAC address (xx:xx:xx:xx:xx:xx hex) -->
  <PTYPE name="TERTOOS_MAC"
         method="regexp"
         pattern="[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}"
         help="MAC address aa:bb:cc:dd:ee:ff"/>

  <!-- S15 — STP bridge priority 0..61440 (steps of 4096) -->
  <PTYPE name="TERTOOS_STP_PRIORITY"
         method="regexp"
         pattern="0|4096|8192|12288|16384|20480|24576|28672|32768|36864|40960|45056|49152|53248|57344|61440"
         help="STP bridge priority (0..61440 in steps of 4096)"/>

  <!-- S15 — STP port priority 0..240 (steps of 16) -->
  <PTYPE name="TERTOOS_STP_PORT_PRIORITY"
         method="regexp"
         pattern="0|16|32|48|64|80|96|112|128|144|160|176|192|208|224|240"
         help="STP port priority (0..240 in steps of 16)"/>

  <!-- S15 — STP path cost 1..200000000 -->
  <PTYPE name="TERTOOS_STP_COST"
         method="regexp"
         pattern="[1-9][0-9]{0,8}"
         help="STP path cost (1..200000000)"/>

  <!-- S15 — VLAN range / list (ex: 100, 100-200, 100,200,300, 100-200,300) -->
  <PTYPE name="TERTOOS_VLAN_LIST"
         method="regexp"
         pattern="[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*"
         help="VLAN id, range, or list (ex: 100, 100-200, 100,200,300)"/>

  <!-- S15 — Storm-control type (regexp_select -> Tab lists the values) -->
  <PTYPE name="TERTOOS_STORM_TYPE"
         method="regexp_select"
         pattern="broadcast|multicast|unknown-unicast"
         ext_pattern="broadcast(broadcast) multicast(multicast) unknown-unicast(unknown-unicast)"
         help="broadcast | multicast | unknown-unicast"/>

  <!-- Interface index — the numeric part after the type keyword in the
       two-token `interface <type> <num>` form. Accepts a plain index
       (0, 54) or a sub-interface (<index>.<vlan>, e.g. 0.100). -->
  <PTYPE name="TERTOOS_IFNUM"
         method="regexp"
         pattern="([0-9]+(\.[0-9]+)?)|(\.[0-9]+)"
         help="Index (0), sub-interface (0.100), or .vlan for named ports (e.g. .100 -&gt; sfp1.100)"/>

  <!-- WireGuard base64 key (32 bytes -> 44 chars, trailing '='). Lax on length. -->
  <PTYPE name="TERTOOS_WGKEY"
         method="regexp"
         pattern="[A-Za-z0-9+/]{42,43}={0,2}"
         help="WireGuard base64 public key (44 chars)"/>

  <!-- IPv4 address (validation only; octet range checked by YANG/backend) -->
  <PTYPE name="TERTOOS_IPV4_ADDR"
         method="regexp"
         pattern="([0-9]{1,3}\.){3}[0-9]{1,3}"
         help="IPv4 address A.B.C.D"/>

  <!-- PW/L2VPN MTU — derived from YANG range 64..9216 (tertoos-l2vpn.yang) -->
  <PTYPE name="TERTOOS_MTU"
         method="regexp"
         pattern="(6[4-9])|([7-9][0-9])|([1-9][0-9]{2})|([1-8][0-9]{3})|(9[01][0-9]{2})|(920[0-9])|(921[0-6])"
         help="MTU 64..9216"/>

  <!-- Pseudowire id — YANG uint32 range 1..4294967295 (lax upper bound) -->
  <PTYPE name="TERTOOS_PW_ID"
         method="regexp"
         pattern="[1-9][0-9]{0,9}"
         help="Pseudowire id 1..4294967295"/>

  <!-- enable | disable toggle with Tab-completion -->
  <PTYPE name="TERTOOS_ENABLE_DISABLE"
         method="regexp_select"
         pattern="enable|disable"
         ext_pattern="enable(enable) disable(disable)"
         help="enable | disable"/>

  <!-- PW transport-mode — YANG enum pw_transport_mode (tertoos-l2vpn.yang) -->
  <PTYPE name="TERTOOS_PW_TRANSPORT_MODE"
         method="regexp_select"
         pattern="ethernet|vlan"
         ext_pattern="ethernet(ethernet) vlan(vlan)"
         help="ethernet | vlan"/>

  <!-- Single-token interface name with Tab-completion (Dell klish extension:
       method="regexp_select" validates against `pattern` but offers the
       `ext_pattern` Name(value) items as Tab/? candidates). Candidates cover
       the E530-24x2c panel (Ethernet1..26) plus Ethernet0 (VS/x86 SKU) and
       the logical types; validation stays permissive so any interface-ish
       token (sub-interfaces Ethernet1.100, PortChannel1, mgmt0) is accepted
       exactly as the old STRING ptype did. -->
  <PTYPE name="TERTOOS_IFNAME"
         method="regexp_select"
         pattern="[A-Za-z][A-Za-z0-9._/-]*"
         ext_pattern="Ethernet0(Ethernet0) Ethernet1(Ethernet1) Ethernet2(Ethernet2) Ethernet3(Ethernet3) Ethernet4(Ethernet4) Ethernet5(Ethernet5) Ethernet6(Ethernet6) Ethernet7(Ethernet7) Ethernet8(Ethernet8) Ethernet9(Ethernet9) Ethernet10(Ethernet10) Ethernet11(Ethernet11) Ethernet12(Ethernet12) Ethernet13(Ethernet13) Ethernet14(Ethernet14) Ethernet15(Ethernet15) Ethernet16(Ethernet16) Ethernet17(Ethernet17) Ethernet18(Ethernet18) Ethernet19(Ethernet19) Ethernet20(Ethernet20) Ethernet21(Ethernet21) Ethernet22(Ethernet22) Ethernet23(Ethernet23) Ethernet24(Ethernet24) Ethernet25(Ethernet25) Ethernet26(Ethernet26) Bundle-Ether(Bundle-Ether) Loopback(Loopback) Mgmt(Mgmt)"
         ext_pattern_cmd="tertoos-cli complete interface"
         help="Interface name (e.g. Ethernet1, Ethernet1.100, Bundle-Ether2, Loopback0)"/>

  <!-- Dynamic completion PTYPEs (TertoOS ext_pattern_cmd): the Tab/?
       candidates come from `tertoos-cli complete <type>` at runtime, so
       objects the operator created — even uncommitted ones still in the
       candidate session — show up. Validation stays permissive (same regex
       as TERTOOS_NAME); the backend/YANG remains the real gatekeeper. -->
  <PTYPE name="TERTOOS_PW_CLASS_NAME"
         method="regexp_select"
         pattern="[A-Za-z][A-Za-z0-9_\-]{0,63}"
         ext_pattern_cmd="tertoos-cli complete pw-class"
         help="Pw-class name (Tab lists the configured ones)"/>

  <PTYPE name="TERTOOS_XCONNECT_GROUP_NAME"
         method="regexp_select"
         pattern="[A-Za-z][A-Za-z0-9_\-]{0,63}"
         ext_pattern_cmd="tertoos-cli complete xconnect-group"
         help="Xconnect group name (Tab lists the configured ones)"/>

  <PTYPE name="TERTOOS_BD_NAME"
         method="regexp_select"
         pattern="[A-Za-z][A-Za-z0-9_\-]{0,63}"
         ext_pattern_cmd="tertoos-cli complete bridge-domain"
         help="Bridge-domain name (Tab lists the configured ones)"/>

  <PTYPE name="TERTOOS_VFI_NAME"
         method="regexp_select"
         pattern="[A-Za-z][A-Za-z0-9_\-]{0,63}"
         ext_pattern_cmd="tertoos-cli complete vfi"
         help="VFI name (Tab lists the configured ones)"/>

  <PTYPE name="TERTOOS_STATIC_PW_NAME"
         method="regexp_select"
         pattern="[A-Za-z][A-Za-z0-9_\-]{0,63}"
         ext_pattern_cmd="tertoos-cli complete static-pw"
         help="Static PW name (Tab lists the configured ones)"/>

  <PTYPE name="TERTOOS_VRF_NAME"
         method="regexp_select"
         pattern="[A-Za-z][A-Za-z0-9_\-]{0,63}"
         ext_pattern_cmd="tertoos-cli complete vrf"
         help="VRF name (Tab lists the configured ones)"/>

  <!-- ================================================================
       Enums estaticos (backlog secao 2 da matriz klish-ptype):
       regexp_select SEM ext_pattern_cmd = candidatos fixos no Tab/?,
       validacao pelo pattern. Um PTYPE por conjunto de valores;
       reusado em todos os params com o mesmo conjunto.
       ================================================================ -->

  <!-- Toggles / pares genericos -->
  <PTYPE name="TERTOOS_TRUE_FALSE"
         method="regexp_select"
         pattern="true|false"
         ext_pattern="true(true) false(false)"
         help="true | false"/>

  <PTYPE name="TERTOOS_ON_OFF"
         method="regexp_select"
         pattern="on|off"
         ext_pattern="on(on) off(off)"
         help="on | off"/>

  <PTYPE name="TERTOOS_IN_OUT"
         method="regexp_select"
         pattern="in|out"
         ext_pattern="in(in) out(out)"
         help="in | out"/>

  <PTYPE name="TERTOOS_INGRESS_EGRESS"
         method="regexp_select"
         pattern="ingress|egress"
         ext_pattern="ingress(ingress) egress(egress)"
         help="ingress | egress"/>

  <PTYPE name="TERTOOS_RX_TX_BOTH"
         method="regexp_select"
         pattern="rx|tx|both"
         ext_pattern="rx(rx) tx(tx) both(both)"
         help="rx | tx | both"/>

  <PTYPE name="TERTOOS_FORWARD_DROP"
         method="regexp_select"
         pattern="forward|drop"
         ext_pattern="forward(forward) drop(drop)"
         help="forward | drop"/>

  <PTYPE name="TERTOOS_STATIC_DYNAMIC"
         method="regexp_select"
         pattern="static|dynamic"
         ext_pattern="static(static) dynamic(dynamic)"
         help="static | dynamic"/>

  <PTYPE name="TERTOOS_ANY_ALL"
         method="regexp_select"
         pattern="any|all"
         ext_pattern="any(any) all(all)"
         help="any | all"/>

  <PTYPE name="TERTOOS_IPV4_IPV6"
         method="regexp_select"
         pattern="ipv4|ipv6"
         ext_pattern="ipv4(ipv4) ipv6(ipv6)"
         help="ipv4 | ipv6"/>

  <PTYPE name="TERTOOS_UDP_TCP"
         method="regexp_select"
         pattern="udp|tcp"
         ext_pattern="udp(udp) tcp(tcp)"
         help="udp | tcp"/>

  <PTYPE name="TERTOOS_RO_RW"
         method="regexp_select"
         pattern="ro|rw"
         ext_pattern="ro(ro) rw(rw)"
         help="ro (read-only) | rw (read-write)"/>

  <PTYPE name="TERTOOS_BYTES_PACKETS"
         method="regexp_select"
         pattern="bytes|packets"
         ext_pattern="bytes(bytes) packets(packets)"
         help="bytes | packets"/>

  <!-- 0=plain | 7=encrypted (estilo IOS) -->
  <PTYPE name="TERTOOS_PASSWORD_ENC"
         method="regexp_select"
         pattern="0|7"
         ext_pattern="0(0) 7(7)"
         help="0 (plain) | 7 (encrypted)"/>

  <PTYPE name="TERTOOS_IMPORT_EXPORT_BOTH"
         method="regexp_select"
         pattern="import|export|both"
         ext_pattern="import(import) export(export) both(both)"
         help="import | export | both"/>

  <!-- Interface / L2 -->
  <PTYPE name="TERTOOS_LACP_MODE"
         method="regexp_select"
         pattern="active|passive|on"
         ext_pattern="active(active) passive(passive) on(on)"
         help="active | passive | on"/>

  <PTYPE name="TERTOOS_STORM_UNIT"
         method="regexp_select"
         pattern="kbps|pps"
         ext_pattern="kbps(kbps) pps(pps)"
         help="kbps | pps"/>

  <PTYPE name="TERTOOS_MAC_LIMIT_ACTION"
         method="regexp_select"
         pattern="drop|shutdown|log"
         ext_pattern="drop(drop) shutdown(shutdown) log(log)"
         help="drop | shutdown | log"/>

  <!-- OSPF / OSPFv3 -->
  <PTYPE name="TERTOOS_OSPF_NETWORK_TYPE"
         method="regexp_select"
         pattern="point-to-point|broadcast|non-broadcast|point-to-multipoint"
         ext_pattern="point-to-point(point-to-point) broadcast(broadcast) non-broadcast(non-broadcast) point-to-multipoint(point-to-multipoint)"
         help="point-to-point | broadcast | non-broadcast | point-to-multipoint"/>

  <PTYPE name="TERTOOS_OSPF_IF_AUTH"
         method="regexp_select"
         pattern="text|message-digest|null"
         ext_pattern="text(text) message-digest(message-digest) null(null)"
         help="text | message-digest | null"/>

  <PTYPE name="TERTOOS_OSPF_AREA_AUTH"
         method="regexp_select"
         pattern="message-digest|text"
         ext_pattern="message-digest(message-digest) text(text)"
         help="message-digest | text"/>

  <!-- broadcast | point-to-point (OSPFv3 network / IS-IS network) -->
  <PTYPE name="TERTOOS_P2P_BROADCAST"
         method="regexp_select"
         pattern="broadcast|point-to-point"
         ext_pattern="broadcast(broadcast) point-to-point(point-to-point)"
         help="broadcast | point-to-point"/>

  <!-- redistribute nas views OSPF/OSPFv3 -->
  <PTYPE name="TERTOOS_REDIST_PROTO"
         method="regexp_select"
         pattern="connected|static|bgp"
         ext_pattern="connected(connected) static(static) bgp(bgp)"
         help="connected | static | bgp"/>

  <!-- IS-IS -->
  <PTYPE name="TERTOOS_ISIS_LEVEL_TYPE"
         method="regexp_select"
         pattern="level-1|level-2-only|level-1-2"
         ext_pattern="level-1(level-1) level-2-only(level-2-only) level-1-2(level-1-2)"
         help="level-1 | level-2-only | level-1-2"/>

  <PTYPE name="TERTOOS_ISIS_LEVEL"
         method="regexp_select"
         pattern="level-1|level-2|level-1-2"
         ext_pattern="level-1(level-1) level-2(level-2) level-1-2(level-1-2)"
         help="level-1 | level-2 | level-1-2"/>

  <PTYPE name="TERTOOS_ISIS_AUTH_TYPE"
         method="regexp_select"
         pattern="clear|md5"
         ext_pattern="clear(clear) md5(md5)"
         help="clear | md5"/>

  <PTYPE name="TERTOOS_ISIS_METRIC_STYLE"
         method="regexp_select"
         pattern="narrow|wide|transition"
         ext_pattern="narrow(narrow) wide(wide) transition(transition)"
         help="narrow | wide | transition"/>

  <!-- redistribute na view IS-IS (inclui ospf) -->
  <PTYPE name="TERTOOS_REDIST_PROTO_ISIS"
         method="regexp_select"
         pattern="connected|static|bgp|ospf"
         ext_pattern="connected(connected) static(static) bgp(bgp) ospf(ospf)"
         help="connected | static | bgp | ospf"/>

  <!-- AAA / seguranca / linha -->
  <PTYPE name="TERTOOS_TACACS_AUTH_TYPE"
         method="regexp_select"
         pattern="pap|chap|login|mschap"
         ext_pattern="pap(pap) chap(chap) login(login) mschap(mschap)"
         help="pap | chap | login | mschap"/>

  <PTYPE name="TERTOOS_USER_ROLE"
         method="regexp_select"
         pattern="admin|operator|netadmin|secadmin|read-only"
         ext_pattern="admin(admin) operator(operator) netadmin(netadmin) secadmin(secadmin) read-only(read-only)"
         help="admin | operator | netadmin | secadmin | read-only"/>

  <PTYPE name="TERTOOS_LINE_TRANSPORT"
         method="regexp_select"
         pattern="ssh|telnet|all|none"
         ext_pattern="ssh(ssh) telnet(telnet) all(all) none(none)"
         help="ssh | telnet | all | none"/>

  <!-- ACL: pattern aceita numero de protocolo tambem; Tab so lista os nomes -->
  <PTYPE name="TERTOOS_ACL_PROTO_V4"
         method="regexp_select"
         pattern="ip|tcp|udp|icmp|[0-9]{1,3}"
         ext_pattern="ip(ip) tcp(tcp) udp(udp) icmp(icmp)"
         help="ip | tcp | udp | icmp | protocol number"/>

  <PTYPE name="TERTOOS_ACL_PROTO_V6"
         method="regexp_select"
         pattern="ipv6|tcp|udp|icmpv6|[0-9]{1,3}"
         ext_pattern="ipv6(ipv6) tcp(tcp) udp(udp) icmpv6(icmpv6)"
         help="ipv6 | tcp | udp | icmpv6 | protocol number"/>

  <!-- Routing-policy -->
  <PTYPE name="TERTOOS_PREFIX_MATCH_KW"
         method="regexp_select"
         pattern="le|ge|eq"
         ext_pattern="le(le) ge(ge) eq(eq)"
         help="le | ge | eq"/>

  <PTYPE name="TERTOOS_BGP_ORIGIN"
         method="regexp_select"
         pattern="igp|egp|incomplete"
         ext_pattern="igp(igp) egp(egp) incomplete(incomplete)"
         help="igp | egp | incomplete"/>

  <!-- BGP -->
  <PTYPE name="TERTOOS_SEND_COMMUNITY"
         method="regexp_select"
         pattern="standard|extended|both|large|all|none"
         ext_pattern="standard(standard) extended(extended) both(both) large(large) all(all) none(none)"
         help="standard | extended | both | large | all | none"/>

  <!-- EVPN -->
  <PTYPE name="TERTOOS_EVPN_ENCAP"
         method="regexp_select"
         pattern="vxlan|mpls"
         ext_pattern="vxlan(vxlan) mpls(mpls)"
         help="vxlan | mpls"/>

  <PTYPE name="TERTOOS_ES_ID_TYPE"
         method="regexp_select"
         pattern="type-0|type-1|type-3|type-5"
         ext_pattern="type-0(type-0) type-1(type-1) type-3(type-3) type-5(type-5)"
         help="type-0 | type-1 | type-3 | type-5"/>

  <PTYPE name="TERTOOS_ES_RED_MODE"
         method="regexp_select"
         pattern="all-active|single-active"
         ext_pattern="all-active(all-active) single-active(single-active)"
         help="all-active | single-active"/>

  <PTYPE name="TERTOOS_DF_ELECTION"
         method="regexp_select"
         pattern="service-carving|preference"
         ext_pattern="service-carving(service-carving) preference(preference)"
         help="service-carving | preference"/>

  <!-- Servicos de sistema -->
  <PTYPE name="TERTOOS_LLDP_TLV"
         method="regexp_select"
         pattern="mgmt-address|system-capabilities"
         ext_pattern="mgmt-address(mgmt-address) system-capabilities(system-capabilities)"
         help="mgmt-address | system-capabilities"/>

  <PTYPE name="TERTOOS_NTP_KEY_ALG"
         method="regexp_select"
         pattern="md5|sha1"
         ext_pattern="md5(md5) sha1(sha1)"
         help="md5 | sha1"/>

  <PTYPE name="TERTOOS_LOG_SEVERITY"
         method="regexp_select"
         pattern="emerg|alert|crit|error|warning|notice|info|debug"
         ext_pattern="emerg(emerg) alert(alert) crit(crit) error(error) warning(warning) notice(notice) info(info) debug(debug)"
         help="emerg | alert | crit | error | warning | notice | info | debug"/>

  <PTYPE name="TERTOOS_SNMP_AUTH_MODE"
         method="regexp_select"
         pattern="noauth|auth-md5|auth-sha"
         ext_pattern="noauth(noauth) auth-md5(auth-md5) auth-sha(auth-sha)"
         help="noauth | auth-md5 | auth-sha"/>

  <PTYPE name="TERTOOS_GRPC_CLIENT_AUTH"
         method="regexp_select"
         pattern="cert|password|none"
         ext_pattern="cert(cert) password(password) none(none)"
         help="cert | password | none"/>

  <!-- QoS -->
  <PTYPE name="TERTOOS_WRED_ECN"
         method="regexp_select"
         pattern="ecn_none|ecn_green|ecn_yellow|ecn_red|ecn_green_yellow|ecn_green_red|ecn_yellow_red|ecn_all"
         ext_pattern="ecn_none(ecn_none) ecn_green(ecn_green) ecn_yellow(ecn_yellow) ecn_red(ecn_red) ecn_green_yellow(ecn_green_yellow) ecn_green_red(ecn_green_red) ecn_yellow_red(ecn_yellow_red) ecn_all(ecn_all)"
         help="ECN marking mode (ecn_none .. ecn_all)"/>

  <PTYPE name="TERTOOS_WRED_COLOR"
         method="regexp_select"
         pattern="green|yellow|red"
         ext_pattern="green(green) yellow(yellow) red(red)"
         help="green | yellow | red"/>

  <PTYPE name="TERTOOS_DISCARD_ACTION"
         method="regexp_select"
         pattern="drop|trim"
         ext_pattern="drop(drop) trim(trim)"
         help="drop | trim"/>

  <PTYPE name="TERTOOS_SCHEDULER_TYPE"
         method="regexp_select"
         pattern="DWRR|STRICT|WRR"
         ext_pattern="DWRR(DWRR) STRICT(STRICT) WRR(WRR)"
         help="DWRR | STRICT | WRR"/>

  <!-- Policer -->
  <PTYPE name="TERTOOS_POLICER_MODE"
         method="regexp_select"
         pattern="sr_tcm|tr_tcm|storm"
         ext_pattern="sr_tcm(sr_tcm) tr_tcm(tr_tcm) storm(storm)"
         help="sr_tcm | tr_tcm | storm"/>

  <PTYPE name="TERTOOS_POLICER_COLOR"
         method="regexp_select"
         pattern="aware|blind"
         ext_pattern="aware(aware) blind(blind)"
         help="aware | blind"/>

  <!-- SR-TE -->
  <PTYPE name="TERTOOS_SRTE_PROTO_ORIGIN"
         method="regexp_select"
         pattern="configured|pcep|bgp"
         ext_pattern="configured(configured) pcep(pcep) bgp(bgp)"
         help="configured | pcep | bgp"/>

