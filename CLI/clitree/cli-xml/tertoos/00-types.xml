<?xml version="1.0" encoding="UTF-8"?>
<!--
  TertoOS — types (PTYPE) compartilhados entre todas as views IOS-XR.
  Centralizar regex aqui evita divergência entre módulos.
-->
<CLISH_MODULE
    xmlns="http://www.dellemc.com/sonic/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.dellemc.com/sonic/XMLSchema
                        http://www.dellemc.com/sonic/XMLSchema/clish.xsd">

  <!-- AS number 1..4294967295 (4-byte ASN) -->
  <PTYPE name="TERTOOS_ASN"
         method="regexp"
         pattern="([1-9][0-9]{0,9})|([1-9][0-9]{0,4}\.[0-9]+)"
         help="AS number (1-4294967295) or asdot (X.Y)"/>

  <!-- IS-IS NET: 49.0001.aabb.ccdd.eeff.00 -->
  <PTYPE name="TERTOOS_ISIS_NET"
         method="regexp"
         pattern="[0-9a-fA-F]{2}(\.[0-9a-fA-F]{4}){3,9}\.00"
         help="IS-IS NET (e.g. 49.0001.0000.0000.0001.00)"/>

  <!-- MPLS label 16..1048575 (reserved 0-15 excluded) -->
  <PTYPE name="TERTOOS_MPLS_LABEL"
         method="regexp"
         pattern="(1[6-9])|([2-9][0-9])|([1-9][0-9]{2,5})|(10[0-3][0-9]{4})|(104[0-7][0-9]{3})|(1048[0-4][0-9]{2})|(10485[0-6][0-9])|(104857[0-5])"
         help="MPLS label 16..1048575"/>

  <!-- Bundle-Ether id -->
  <PTYPE name="TERTOOS_BUNDLE_ID"
         method="regexp"
         pattern="[1-9][0-9]{0,3}"
         help="Bundle-Ether id 1..9999"/>

  <!-- Route Distinguisher: ASN:nn or A.B.C.D:nn -->
  <PTYPE name="TERTOOS_RD"
         method="regexp"
         pattern="([0-9]+:[0-9]+)|([0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]+)"
         help="Route Distinguisher (ASN:nn or IP:nn)"/>

  <!-- Route Target same shape as RD -->
  <PTYPE name="TERTOOS_RT"
         method="regexp"
         pattern="([0-9]+:[0-9]+)|([0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]+)"
         help="Route Target"/>

  <!-- VLAN id 1..4094 -->
  <PTYPE name="TERTOOS_VLAN_ID"
         method="regexp"
         pattern="([1-9])|([1-9][0-9]{1,2})|([1-3][0-9]{3})|(40[0-8][0-9])|(409[0-4])"
         help="VLAN id 1..4094"/>

  <!-- Identifier (name) -->
  <PTYPE name="TERTOOS_NAME"
         method="regexp"
         pattern="[A-Za-z][A-Za-z0-9_\-]{0,63}"
         help="Identifier (alpha first, 1..64 chars)"/>

  <!-- IPv4 prefix -->
  <PTYPE name="TERTOOS_IPV4_PREFIX"
         method="regexp"
         pattern="([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[1-2][0-9]|3[0-2])"
         help="IPv4 prefix A.B.C.D/M"/>

  <!-- IPv6 prefix (lax — full validation in YANG) -->
  <PTYPE name="TERTOOS_IPV6_PREFIX"
         method="regexp"
         pattern="[0-9a-fA-F:]+/([0-9]|[1-9][0-9]|1[0-1][0-9]|12[0-8])"
         help="IPv6 prefix X:X::X/M"/>

  <!-- S15 — MAC address (xx:xx:xx:xx:xx:xx hex) -->
  <PTYPE name="TERTOOS_MAC"
         method="regexp"
         pattern="[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}"
         help="MAC address aa:bb:cc:dd:ee:ff"/>

  <!-- S15 — STP bridge priority 0..61440 (steps of 4096) -->
  <PTYPE name="TERTOOS_STP_PRIORITY"
         method="regexp"
         pattern="0|4096|8192|12288|16384|20480|24576|28672|32768|36864|40960|45056|49152|53248|57344|61440"
         help="STP bridge priority (0..61440 in steps of 4096)"/>

  <!-- S15 — STP port priority 0..240 (steps of 16) -->
  <PTYPE name="TERTOOS_STP_PORT_PRIORITY"
         method="regexp"
         pattern="0|16|32|48|64|80|96|112|128|144|160|176|192|208|224|240"
         help="STP port priority (0..240 in steps of 16)"/>

  <!-- S15 — STP path cost 1..200000000 -->
  <PTYPE name="TERTOOS_STP_COST"
         method="regexp"
         pattern="[1-9][0-9]{0,8}"
         help="STP path cost (1..200000000)"/>

  <!-- S15 — VLAN range / list (ex: 100, 100-200, 100,200,300, 100-200,300) -->
  <PTYPE name="TERTOOS_VLAN_LIST"
         method="regexp"
         pattern="[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*"
         help="VLAN id, range, or list (ex: 100, 100-200, 100,200,300)"/>

  <!-- S15 — Storm-control type -->
  <PTYPE name="TERTOOS_STORM_TYPE"
         method="regexp"
         pattern="broadcast|multicast|unknown-unicast"
         help="broadcast | multicast | unknown-unicast"/>

  <!-- Interface index — the numeric part after the type keyword in the
       two-token `interface <type> <num>` form. Accepts a plain index
       (0, 54) or a sub-interface (<index>.<vlan>, e.g. 0.100). -->
  <PTYPE name="TERTOOS_IFNUM"
         method="regexp"
         pattern="([0-9]+(\.[0-9]+)?)|(\.[0-9]+)"
         help="Index (0), sub-interface (0.100), or .vlan for named ports (e.g. .100 -&gt; sfp1.100)"/>

  <!-- WireGuard base64 key (32 bytes -> 44 chars, trailing '='). Lax on length. -->
  <PTYPE name="TERTOOS_WGKEY"
         method="regexp"
         pattern="[A-Za-z0-9+/]{42,43}={0,2}"
         help="WireGuard base64 public key (44 chars)"/>

  <!-- IPv4 address (validation only; octet range checked by YANG/backend) -->
  <PTYPE name="TERTOOS_IPV4_ADDR"
         method="regexp"
         pattern="([0-9]{1,3}\.){3}[0-9]{1,3}"
         help="IPv4 address A.B.C.D"/>

  <!-- PW/L2VPN MTU — derived from YANG range 64..9216 (tertoos-l2vpn.yang) -->
  <PTYPE name="TERTOOS_MTU"
         method="regexp"
         pattern="(6[4-9])|([7-9][0-9])|([1-9][0-9]{2})|([1-8][0-9]{3})|(9[01][0-9]{2})|(920[0-9])|(921[0-6])"
         help="MTU 64..9216"/>

  <!-- Pseudowire id — YANG uint32 range 1..4294967295 (lax upper bound) -->
  <PTYPE name="TERTOOS_PW_ID"
         method="regexp"
         pattern="[1-9][0-9]{0,9}"
         help="Pseudowire id 1..4294967295"/>

  <!-- enable | disable toggle with Tab-completion -->
  <PTYPE name="TERTOOS_ENABLE_DISABLE"
         method="regexp_select"
         pattern="enable|disable"
         ext_pattern="enable(enable) disable(disable)"
         help="enable | disable"/>

  <!-- PW transport-mode — YANG enum pw_transport_mode (tertoos-l2vpn.yang) -->
  <PTYPE name="TERTOOS_PW_TRANSPORT_MODE"
         method="regexp_select"
         pattern="ethernet|vlan"
         ext_pattern="ethernet(ethernet) vlan(vlan)"
         help="ethernet | vlan"/>

  <!-- Single-token interface name with Tab-completion (Dell klish extension:
       method="regexp_select" validates against `pattern` but offers the
       `ext_pattern` Name(value) items as Tab/? candidates). Candidates cover
       the E530-24x2c panel (Ethernet1..26) plus Ethernet0 (VS/x86 SKU) and
       the logical types; validation stays permissive so any interface-ish
       token (sub-interfaces Ethernet1.100, PortChannel1, mgmt0) is accepted
       exactly as the old STRING ptype did. -->
  <PTYPE name="TERTOOS_IFNAME"
         method="regexp_select"
         pattern="[A-Za-z][A-Za-z0-9._/-]*"
         ext_pattern="Ethernet0(Ethernet0) Ethernet1(Ethernet1) Ethernet2(Ethernet2) Ethernet3(Ethernet3) Ethernet4(Ethernet4) Ethernet5(Ethernet5) Ethernet6(Ethernet6) Ethernet7(Ethernet7) Ethernet8(Ethernet8) Ethernet9(Ethernet9) Ethernet10(Ethernet10) Ethernet11(Ethernet11) Ethernet12(Ethernet12) Ethernet13(Ethernet13) Ethernet14(Ethernet14) Ethernet15(Ethernet15) Ethernet16(Ethernet16) Ethernet17(Ethernet17) Ethernet18(Ethernet18) Ethernet19(Ethernet19) Ethernet20(Ethernet20) Ethernet21(Ethernet21) Ethernet22(Ethernet22) Ethernet23(Ethernet23) Ethernet24(Ethernet24) Ethernet25(Ethernet25) Ethernet26(Ethernet26) Bundle-Ether(Bundle-Ether) Loopback(Loopback) Mgmt(Mgmt)"
         ext_pattern_cmd="timeout 3 tertoos-cli complete interface"
         help="Interface name (e.g. Ethernet1, Ethernet1.100, Bundle-Ether2, Loopback0)"/>

  <!-- Dynamic completion PTYPEs (TertoOS ext_pattern_cmd): the Tab/?
       candidates come from `tertoos-cli complete <type>` at runtime, so
       objects the operator created — even uncommitted ones still in the
       candidate session — show up. Validation stays permissive (same regex
       as TERTOOS_NAME); the backend/YANG remains the real gatekeeper. -->
  <PTYPE name="TERTOOS_PW_CLASS_NAME"
         method="regexp_select"
         pattern="[A-Za-z][A-Za-z0-9_\-]{0,63}"
         ext_pattern_cmd="timeout 3 tertoos-cli complete pw-class"
         help="Pw-class name (Tab lists the configured ones)"/>

  <PTYPE name="TERTOOS_XCONNECT_GROUP_NAME"
         method="regexp_select"
         pattern="[A-Za-z][A-Za-z0-9_\-]{0,63}"
         ext_pattern_cmd="timeout 3 tertoos-cli complete xconnect-group"
         help="Xconnect group name (Tab lists the configured ones)"/>

  <PTYPE name="TERTOOS_BD_NAME"
         method="regexp_select"
         pattern="[A-Za-z][A-Za-z0-9_\-]{0,63}"
         ext_pattern_cmd="timeout 3 tertoos-cli complete bridge-domain"
         help="Bridge-domain name (Tab lists the configured ones)"/>

  <PTYPE name="TERTOOS_VFI_NAME"
         method="regexp_select"
         pattern="[A-Za-z][A-Za-z0-9_\-]{0,63}"
         ext_pattern_cmd="timeout 3 tertoos-cli complete vfi"
         help="VFI name (Tab lists the configured ones)"/>

  <PTYPE name="TERTOOS_STATIC_PW_NAME"
         method="regexp_select"
         pattern="[A-Za-z][A-Za-z0-9_\-]{0,63}"
         ext_pattern_cmd="timeout 3 tertoos-cli complete static-pw"
         help="Static PW name (Tab lists the configured ones)"/>

  <PTYPE name="TERTOOS_VRF_NAME"
         method="regexp_select"
         pattern="[A-Za-z][A-Za-z0-9_\-]{0,63}"
         ext_pattern_cmd="timeout 3 tertoos-cli complete vrf"
         help="VRF name (Tab lists the configured ones)"/>

</CLISH_MODULE>
