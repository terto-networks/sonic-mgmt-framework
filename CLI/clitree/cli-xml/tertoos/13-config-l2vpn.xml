<?xml version="1.0" encoding="UTF-8"?>
<!--
  TertoOS — l2vpn views (IOS-XR style VPWS).

  Estrutura IOS-XR vs CONFIG_DB:
    pw-class <name>                              → L2VPN_PW_CLASS|<name>
    l2vpn xconnect group <g> p2p <p>             → L2VPN_XCONNECT_GROUP|<g>|<p>
      interface <if>                             → leaf interface
      neighbor ipv4 <ip> pw-id <n>               → leaves peer-address + pw-id
      pw-class <c>                               → leaf pw-class

  Backend: frrcfgd renderiza via templates/ldpd/ldpd.conf.db.l2vpn.j2 →
  FRR ldpd (mpls ldp\n l2vpn ... pwtype ethernet\n bridge ...).

  Gating SAI: dataplane L2VPN não funciona no AS5912 (Trident III).
  Funcional no Centec quando lab estiver pronto.
-->
<CLISH_MODULE
    xmlns="http://www.dellemc.com/sonic/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.dellemc.com/sonic/XMLSchema
                        http://www.dellemc.com/sonic/XMLSchema/clish.xsd">

  <VIEW name="config-view">

    <COMMAND name="pw-class"
             help="Configure a pseudowire class"
             view="config-pw-class-view"
             viewid="pwcname=${name}">
      <PARAM name="name" help="Pw-class name" ptype="TERTOOS_NAME"/>
      <ACTION>
        tertoos-cli candidate context pw-class ${name}&#xA;
        tertoos-cli candidate set pw-class/${name}&#xA;
      </ACTION>
    </COMMAND>
    <COMMAND name="no pw-class" help="Remove pw-class">
      <PARAM name="name" help="Pw-class name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate delete pw-class/${name}</ACTION>
    </COMMAND>

    <COMMAND name="l2vpn xconnect group"
             help="Configure an L2VPN xconnect group"
             view="config-l2vpn-group-view"
             viewid="l2vpngrp=${name}">
      <PARAM name="name" help="Group name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate context l2vpn-group ${name}</ACTION>
    </COMMAND>
    <COMMAND name="no l2vpn xconnect group" help="Remove an L2VPN group">
      <PARAM name="name" help="Group name" ptype="TERTOOS_NAME"/>
      <ACTION>
        tertoos-cli candidate delete l2vpn/xconnect/${name}/-all&#xA;
      </ACTION>
    </COMMAND>

    <!-- ===== S11.x — Bridge-domain + VFI ================================== -->
    <COMMAND name="bridge-domain"
             help="Configure VPLS bridge-domain"
             view="config-l2vpn-bd-view"
             viewid="bdname=${name}">
      <PARAM name="name" help="Bridge-domain name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate context l2vpn-bd ${name}</ACTION>
    </COMMAND>
    <COMMAND name="no bridge-domain" help="Remove bridge-domain">
      <PARAM name="name" help="Bridge-domain name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate delete l2vpn/bridge-domain/${name}</ACTION>
    </COMMAND>

    <COMMAND name="vfi"
             help="Configure VFI (Virtual Forwarding Instance)"
             view="config-l2vpn-vfi-view"
             viewid="vfiname=${name}">
      <PARAM name="name" help="VFI name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate context l2vpn-vfi ${name}</ACTION>
    </COMMAND>
    <COMMAND name="no vfi" help="Remove VFI">
      <PARAM name="name" help="VFI name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate delete l2vpn/vfi/${name}</ACTION>
    </COMMAND>

  </VIEW>

  <!-- =================== config-l2vpn-bd-view =============================== -->
  <VIEW name="config-l2vpn-bd-view"
        prompt="${SYSTEM_NAME}(config-l2vpn-bd-${bdname})# ">
    <COMMAND name="exit" help="exit" view="config-view"><ACTION>tertoos-cli candidate context pop</ACTION></COMMAND>
    <COMMAND name="end" help="end" view="privileged-view"><ACTION>tertoos-cli candidate end</ACTION></COMMAND>

    <COMMAND name="description" help="Description">
      <PARAM name="text" help="Free text" ptype="STRING_WITH_PIPE"/>
      <ACTION>tertoos-cli candidate set l2vpn/bridge-domain/${bdname}/description "${text}"</ACTION>
    </COMMAND>
    <COMMAND name="mac aging" help="MAC aging time (seconds)">
      <PARAM name="s" help="seconds" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set l2vpn/bridge-domain/${bdname}/mac_aging ${s}</ACTION>
    </COMMAND>
    <COMMAND name="mac limit" help="MAC table limit">
      <PARAM name="n" help="entries" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set l2vpn/bridge-domain/${bdname}/mac_limit ${n}</ACTION>
    </COMMAND>
    <COMMAND name="flooding unknown-unicast" help="Flood unknown unicast">
      <PARAM name="state" help="enable | disable" ptype="STRING"/>
      <ACTION>
        if [ "${state}" = "enable" ]; then&#xA;
            tertoos-cli candidate set l2vpn/bridge-domain/${bdname}/flooding_unknown_unicast true&#xA;
        else&#xA;
            tertoos-cli candidate set l2vpn/bridge-domain/${bdname}/flooding_unknown_unicast false&#xA;
        fi&#xA;
      </ACTION>
    </COMMAND>
    <COMMAND name="flooding broadcast" help="Flood broadcast">
      <PARAM name="state" help="enable | disable" ptype="STRING"/>
      <ACTION>
        if [ "${state}" = "enable" ]; then&#xA;
            tertoos-cli candidate set l2vpn/bridge-domain/${bdname}/flooding_broadcast true&#xA;
        else&#xA;
            tertoos-cli candidate set l2vpn/bridge-domain/${bdname}/flooding_broadcast false&#xA;
        fi&#xA;
      </ACTION>
    </COMMAND>
    <COMMAND name="vfi" help="Bind VFI to this bridge-domain">
      <PARAM name="name" help="VFI name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate set l2vpn/bridge-domain/${bdname}/vfi_name ${name}</ACTION>
    </COMMAND>
    <COMMAND name="interface" help="Add attachment circuit (interface)">
      <PARAM name="ifname" help="Interface name" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set l2vpn/bd-ac/${bdname}/${ifname}</ACTION>
    </COMMAND>
    <COMMAND name="no interface" help="Remove attachment circuit">
      <PARAM name="ifname" help="Interface name" ptype="STRING"/>
      <ACTION>tertoos-cli candidate delete l2vpn/bd-ac/${bdname}/${ifname}</ACTION>
    </COMMAND>
  </VIEW>

  <!-- =================== config-l2vpn-vfi-view ============================== -->
  <VIEW name="config-l2vpn-vfi-view"
        prompt="${SYSTEM_NAME}(config-l2vpn-vfi-${vfiname})# ">
    <COMMAND name="exit" help="exit" view="config-view"><ACTION>tertoos-cli candidate context pop</ACTION></COMMAND>
    <COMMAND name="end" help="end" view="privileged-view"><ACTION>tertoos-cli candidate end</ACTION></COMMAND>

    <COMMAND name="vpn-id" help="VPN identifier">
      <PARAM name="n" help="VPN id" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set l2vpn/vfi/${vfiname}/vpn_id ${n}</ACTION>
    </COMMAND>
    <COMMAND name="pw-class" help="Pseudowire class">
      <PARAM name="name" help="Pw-class name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate set l2vpn/vfi/${vfiname}/pw_class ${name}</ACTION>
    </COMMAND>
    <COMMAND name="manual-signaling" help="Manual full-mesh PWs">
      <ACTION>tertoos-cli candidate set l2vpn/vfi/${vfiname}/manual_signaling true</ACTION>
    </COMMAND>
    <COMMAND name="autodiscovery bgp" help="H-VPLS BGP auto-discovery">
      <ACTION>tertoos-cli candidate set l2vpn/vfi/${vfiname}/autodiscovery_bgp true</ACTION>
    </COMMAND>
    <COMMAND name="route-distinguisher" help="VFI RD">
      <PARAM name="rd" help="ASN:NN or A.B.C.D:NN" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set l2vpn/vfi/${vfiname}/route_distinguisher ${rd}</ACTION>
    </COMMAND>
    <COMMAND name="route-target import" help="VFI RT import">
      <PARAM name="rt" help="ASN:NN" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set l2vpn/vfi/${vfiname}/route_target_import ${rt}</ACTION>
    </COMMAND>
    <COMMAND name="route-target export" help="VFI RT export">
      <PARAM name="rt" help="ASN:NN" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set l2vpn/vfi/${vfiname}/route_target_export ${rt}</ACTION>
    </COMMAND>
    <COMMAND name="neighbor" help="Add manual peer">
      <PARAM name="addr" help="Peer address" ptype="STRING"/>
      <PARAM name="pwid_kw" help="pw-id" ptype="SUBCOMMAND" mode="subcommand" value="pw-id"/>
      <PARAM name="pwid" help="PW id" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set l2vpn/bd-neighbor/${vfiname}/${addr}/pw_id ${pwid}</ACTION>
    </COMMAND>
    <COMMAND name="no neighbor" help="Remove manual peer">
      <PARAM name="addr" help="Peer address" ptype="STRING"/>
      <ACTION>tertoos-cli candidate delete l2vpn/bd-neighbor/${vfiname}/${addr}</ACTION>
    </COMMAND>
  </VIEW>

  <!-- =================== config-pw-class-view =============================== -->
  <VIEW name="config-pw-class-view"
        prompt="${SYSTEM_NAME}(config-pw-class-${pwcname})# ">

    <COMMAND name="exit" help="Exit pw-class" view="config-view">
      <ACTION>tertoos-cli candidate context pop</ACTION>
    </COMMAND>
    <COMMAND name="end" help="Return to privileged EXEC" view="privileged-view">
      <ACTION>tertoos-cli candidate end</ACTION>
    </COMMAND>

    <COMMAND name="encapsulation mpls" help="MPLS encapsulation">
      <ACTION>tertoos-cli candidate set pw-class/${pwcname}/encapsulation mpls</ACTION>
    </COMMAND>
    <COMMAND name="control-word" help="Enable PW control-word">
      <ACTION>tertoos-cli candidate set pw-class/${pwcname}/control-word true</ACTION>
    </COMMAND>
    <COMMAND name="no control-word" help="Disable PW control-word">
      <ACTION>tertoos-cli candidate set pw-class/${pwcname}/control-word false</ACTION>
    </COMMAND>
    <COMMAND name="mtu" help="PW MTU">
      <PARAM name="bytes" help="64..9216" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set pw-class/${pwcname}/mtu ${bytes}</ACTION>
    </COMMAND>
    <COMMAND name="transport-mode" help="Transport mode">
      <PARAM name="mode" help="ethernet | vlan" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set pw-class/${pwcname}/transport-mode ${mode}</ACTION>
    </COMMAND>

  </VIEW>

  <!-- =================== config-l2vpn-group-view ============================ -->
  <VIEW name="config-l2vpn-group-view"
        prompt="${SYSTEM_NAME}(config-l2vpn-${l2vpngrp})# ">

    <COMMAND name="exit" help="Exit l2vpn group" view="config-view">
      <ACTION>tertoos-cli candidate context pop</ACTION>
    </COMMAND>
    <COMMAND name="end" help="Return to privileged EXEC" view="privileged-view">
      <ACTION>tertoos-cli candidate end</ACTION>
    </COMMAND>

    <COMMAND name="p2p"
             help="Configure a point-to-point pseudowire"
             view="config-l2vpn-p2p-view"
             viewid="l2vpngrp=${l2vpngrp};l2vpnp2p=${name}">
      <PARAM name="name" help="P2P name" ptype="TERTOOS_NAME"/>
      <ACTION>
        tertoos-cli candidate context l2vpn-p2p ${name}&#xA;
        tertoos-cli candidate set l2vpn/xconnect/${l2vpngrp}/${name}&#xA;
      </ACTION>
    </COMMAND>
    <COMMAND name="no p2p" help="Remove a p2p">
      <PARAM name="name" help="P2P name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate delete l2vpn/xconnect/${l2vpngrp}/${name}</ACTION>
    </COMMAND>

  </VIEW>

  <!-- =================== config-l2vpn-p2p-view ============================== -->
  <VIEW name="config-l2vpn-p2p-view"
        prompt="${SYSTEM_NAME}(config-l2vpn-${l2vpngrp}-p2p-${l2vpnp2p})# ">

    <COMMAND name="exit" help="Exit p2p" view="config-l2vpn-group-view">
      <ACTION>tertoos-cli candidate context pop</ACTION>
    </COMMAND>
    <COMMAND name="end" help="Return to privileged EXEC" view="privileged-view">
      <ACTION>tertoos-cli candidate end</ACTION>
    </COMMAND>

    <COMMAND name="interface" help="Attachment circuit interface">
      <PARAM name="ifname" help="Interface name" ptype="STRING"/>
      <ACTION>tertoos-cli candidate set l2vpn/xconnect/${l2vpngrp}/${l2vpnp2p}/interface ${ifname}</ACTION>
    </COMMAND>
    <!--
      Sintaxe: neighbor ipv4 <addr> pw-id <pwid>
      Klish 2.x: em PARAM ptype="SUBCOMMAND" mode="subcommand", o `name`
      do PARAM vira o keyword literal que o usuário digita. `help` é só
      display text. Por isso name="ipv4" e name="pw-id" — NÃO `ipv4_kw`
      ou `pwid_kw` (esses viram literais e o usuário teria que digitar
      'ipv4_kw' / 'pwid_kw' — bug).
    -->
    <COMMAND name="neighbor" help="Remote PE peer + PW id">
      <PARAM name="ipv4" help="IPv4 address family" ptype="SUBCOMMAND" mode="subcommand"/>
      <PARAM name="addr" help="A.B.C.D" ptype="STRING"/>
      <PARAM name="pw-id" help="Pseudowire identifier keyword" ptype="SUBCOMMAND" mode="subcommand"/>
      <PARAM name="pwid" help="Pw-id 1..4294967295" ptype="UINT"/>
      <ACTION>
        tertoos-cli candidate set l2vpn/xconnect/${l2vpngrp}/${l2vpnp2p}/peer-address ${addr}&#xA;
        tertoos-cli candidate set l2vpn/xconnect/${l2vpngrp}/${l2vpnp2p}/pw-id ${pwid}&#xA;
      </ACTION>
    </COMMAND>
    <COMMAND name="no neighbor" help="Remove the remote PE peer binding">
      <PARAM name="ipv4" help="IPv4 address family" ptype="SUBCOMMAND" mode="subcommand"/>
      <PARAM name="addr" help="A.B.C.D" ptype="STRING"/>
      <ACTION>
        tertoos-cli candidate delete l2vpn/xconnect/${l2vpngrp}/${l2vpnp2p}/peer-address&#xA;
        tertoos-cli candidate delete l2vpn/xconnect/${l2vpngrp}/${l2vpnp2p}/pw-id&#xA;
      </ACTION>
    </COMMAND>
    <COMMAND name="pw-class" help="Bind a pw-class">
      <PARAM name="name" help="Pw-class name" ptype="TERTOOS_NAME"/>
      <ACTION>tertoos-cli candidate set l2vpn/xconnect/${l2vpngrp}/${l2vpnp2p}/pw-class ${name}</ACTION>
    </COMMAND>
    <COMMAND name="mtu" help="P2P MTU override">
      <PARAM name="bytes" help="64..9216" ptype="UINT"/>
      <ACTION>tertoos-cli candidate set l2vpn/xconnect/${l2vpngrp}/${l2vpnp2p}/mtu ${bytes}</ACTION>
    </COMMAND>
    <COMMAND name="shutdown" help="Disable the p2p">
      <ACTION>tertoos-cli candidate set l2vpn/xconnect/${l2vpngrp}/${l2vpnp2p}/enabled false</ACTION>
    </COMMAND>
    <COMMAND name="no shutdown" help="Enable the p2p">
      <ACTION>tertoos-cli candidate set l2vpn/xconnect/${l2vpngrp}/${l2vpnp2p}/enabled true</ACTION>
    </COMMAND>

  </VIEW>

</CLISH_MODULE>
