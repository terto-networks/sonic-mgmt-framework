#!/bin/bash

export SONIC_MGMT_ROOT=/usr/sbin
export SONIC_CLI_ROOT=$SONIC_MGMT_ROOT/cli
if [ -z $SYSTEM_NAME ]
then
 export SYSTEM_NAME="${HOSTNAME%%.*}"
fi

export PYTHONPATH=/usr/sbin/cli:/usr/sbin/cli/scripts:/usr/sbin
export RENDERER_TEMPLATE_PATH=$SONIC_CLI_ROOT/render-templates
export CLISH_PATH=$SONIC_CLI_ROOT/command-tree
export LD_LIBRARY_PATH=/usr/local/lib:$SONIC_CLI_ROOT/.libs:$LD_LIBRARY_PATH
export PATH=$PATH:/usr/local/sbin:/usr/sbin:/sbin:$SONIC_CLI_ROOT

export KLISH_CLI_USER=$CLI_USER

# RBAC: o wrapper /usr/bin/tertoos entra no container como root e passa a
# identidade real do usuario SSH (CLI_UID/CLI_GID/CLI_GROUPS). Dropamos para esse
# usuario COM seus grupos de role suplementares (sysadmin/netadmin/netoperator)
# via setpriv — o `docker exec -u` nao consegue passar grupos suplementares, e o
# access= do clish enxerga os grupos do PROCESSO. Sem isto o admin era tratado
# como netoperator. Bug pego no smoke RBAC 2026-06-21.
if [ -n "$CLI_UID" ] && command -v setpriv >/dev/null 2>&1; then
    # O `docker exec -u 0:0 -it` aloca o pty como root; apos o setpriv dropar pro
    # usuario, ele nao consegue (re)abrir /dev/stdout (os ACTIONs do clish rodam
    # via sh e redirecionam pro pty) -> "cannot create /dev/stdout: Permission
    # denied". Chown o pty pro usuario ANTES do setpriv (igual login/su).
    # O gid PRIMARIO do usuario SSH (CLI_GID) pode nao existir DENTRO do container:
    # usuario local criado com grupo-privado (useradd -m), ou mapeado via NSS
    # (TACACS/RADIUS/LDAP). O clish TRAVA se rodar com um gid primario desconhecido.
    # O RBAC vem dos grupos SUPLEMENTARES (CLI_GROUPS) — o gid primario nao importa
    # pro role — entao se CLI_GID nao resolve no container, caimos para netoperator
    # (grupo base RBAC, sempre presente). Bug pego no smoke RBAC #6 2026-06-22.
    _regid="${CLI_GID:-$CLI_UID}"
    if ! getent group "$_regid" >/dev/null 2>&1; then
        _no=$(getent group netoperator | cut -d: -f3)
        _regid="${_no:-$CLI_UID}"
    fi
    _tty=$(tty 2>/dev/null || true)
    [ -n "$_tty" ] && [ -e "$_tty" ] && chown "$CLI_UID:$_regid" "$_tty" 2>/dev/null || true
    # TertoOS: vtysh (show operacionais do FRR no Full) faz getpwuid(CLI_UID) no
    # startup; o user-mgmt cria os grupos de role no container mas NAO um usuario no
    # uid do operador. Garantimos um (so pro getpwuid) se faltar — nao conflita com o
    # user-mgmt, que so cria grupos.
    if ! getent passwd "$CLI_UID" >/dev/null 2>&1; then
        echo "cli$CLI_UID:x:$CLI_UID:$_regid::/tmp:/usr/sbin/nologin" >> /etc/passwd
    fi
    # frrvty (gid do socket vty 0770) + frr (ler /etc/frr/frr.conf 0640) dao ao
    # processo do CLI acesso ao FRR via /var/run/frr compartilhado com a docker bgp.
    if [ -n "$CLI_GROUPS" ]; then GRP="--groups $CLI_GROUPS,frrvty,frr"; else GRP="--clear-groups"; fi
    exec setpriv --reuid "$CLI_UID" --regid "$_regid" $GRP \
        "$SONIC_CLI_ROOT/clish" -o "$@"
fi

$SONIC_CLI_ROOT/clish -o "$@"
